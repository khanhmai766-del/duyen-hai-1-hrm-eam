    {
      "parameters": {
        "jsCode": "const raw = String($input.first().json.output || '').trim();\nlet parsed;\ntry {\n  parsed = JSON.parse(raw.replace(/^```(?:json)?\\s*/i, '').replace(/\\s*```$/, ''));\n} catch {\n  parsed = { answer: raw || 'Không tạo được câu trả lời.', citations: [], suggestions: [] };\n}\nreturn [{ json: { answer: String(parsed.answer || ''), citations: Array.isArray(parsed.citations) ? parsed.citations : [], suggestions: Array.isArray(parsed.suggestions) ? parsed.suggestions.slice(0, 4) : [] } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
