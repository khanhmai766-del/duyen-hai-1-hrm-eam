    {
      "parameters": {
        "jsCode": "const response = $json;\nconst status = Number(response.statusCode ?? 200);\nif (status >= 300) {\n  const message = response.body?.error?.message ?? (\"Google Sheets trả mã \" + status);\n  return [{ json: { ok: false, error: message, status } }];\n}\nconst action = $(\"Kiểm yêu cầu\").first().json.action;\nreturn [{ json: action === \"read\"\n  ? { ok: true, values: response.body?.values ?? [] }\n  : { ok: true, updatedCells: response.body?.totalUpdatedCells ?? 0 } }];"
      },
