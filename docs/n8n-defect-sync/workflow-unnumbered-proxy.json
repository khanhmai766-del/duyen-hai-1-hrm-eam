    {
      "parameters": {
        "jsCode": "// Mục tạm \"Dòng chưa số\" (lib/server/defect-unnumbered.ts): web nhờ đọc/ghi Sheet bằng tài khoản Google của n8n.\n// CHỈ cho: đọc DH1!A6:AA, ghi cột N (cột 14) của đúng 2 Sheet khiếm khuyết, giá trị thuộc 5 nhãn trạng thái.\nconst SHEETS = { CO: \"1zKRH9zhEAkCwGRl4KiaNwUlkLg9_l4WXNSBeg3FK_MA\", DIEN: \"1nPKFBr3wXfOFE4y_WACDs7cvb1ZZA-mg0mZbsIuB_lQ\" };\nconst TAB = \"DH1\";\nconst COLUMN = \"N\";\nconst LABELS = [\"Chưa xử lý\", \"Đang xử lý\", \"Chờ vật tư\", \"Chờ ngừng máy\", \"Đã xử lý xong\"];\nconst body = $json.body ?? {};\nconst bad = (error) => [{ json: { valid: false, error } }];\nconst spreadsheetId = SHEETS[body.source];\nif (!spreadsheetId) return bad(\"source phải là CO hoặc DIEN\");\nconst base = \"https://sheets.googleapis.com/v4/spreadsheets/\" + spreadsheetId;\nif (body.action === \"read\") {\n  return [{ json: { valid: true, action: \"read\", url: base + \"/values/\" + encodeURIComponent(TAB + \"!A6:AA\") + \"?majorDimension=ROWS&valueRenderOption=FORMATTED_VALUE\" } }];\n}\nif (body.action === \"write\") {\n  if (body.column !== COLUMN) return bad(\"chỉ được ghi cột \" + COLUMN);\n  const cells = Array.isArray(body.cells) ? body.cells : [];\n  if (!cells.length || cells.length > 200) return bad(\"mỗi lượt ghi 1–200 ô\");\n  for (const cell of cells) {\n    if (!Number.isInteger(cell.row) || cell.row < 7 || cell.row > 20000) return bad(\"số dòng không hợp lệ: \" + cell.row);\n    if (!LABELS.includes(cell.value)) return bad(\"giá trị không hợp lệ: \" + cell.value);\n  }\n  return [{ json: { valid: true, action: \"write\", url: base + \"/values:batchUpdate\", payload: {\n    valueInputOption: \"RAW\",\n    data: cells.map((cell) => ({ range: TAB + \"!\" + COLUMN + cell.row, majorDimension: \"ROWS\", values: [[cell.value]] })),\n  } } }];\n}\nreturn bad(\"action phải là read hoặc write\");"
      },
