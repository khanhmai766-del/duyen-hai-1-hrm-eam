# Ghim phiên bản; không dùng latest và không cài Watchtower.
N8N_VERSION=2.30.5

POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Mất khóa này sẽ không giải mã được Google OAuth credential đã lưu.
N8N_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32

N8N_HOST=n8n.example.internal
