    {
      "parameters": {
        "method": "POST",
        "url": "https://duyenhai1.vn/api/integrations/n8n/defects/outbox/claim?limit=50&exclusive=1",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "claim-batch",
      "name": "Claim tối đa 50 sự kiện",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        -660,
        80
      ],
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 60000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "aqtXWwXwpZ58pFi7",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const events = Array.isArray($json.data) ? $json.data : [];\nif (!events.length) return [];\nconst normalize = (value) => String(value ?? '').normalize('NFD').replace(/[\\u0300-\\u036f]/g, '').replace(/đ/g, 'd').replace(/Đ/g, 'D').toLowerCase().replace(/\\s+/g, ' ').trim();\nconst configs = {\n  CO: { spreadsheetId: '1zKRH9zhEAkCwGRl4KiaNwUlkLg9_l4WXNSBeg3FK_MA', sheetName: 'DH1', requestType: 'Cơ' },\n  CO_MT: { spreadsheetId: '1zKRH9zhEAkCwGRl4KiaNwUlkLg9_l4WXNSBeg3FK_MA', sheetName: 'DH1 MTruong', requestType: 'Môi Trường' },\n  CO_HOA: { spreadsheetId: '1zKRH9zhEAkCwGRl4KiaNwUlkLg9_l4WXNSBeg3FK_MA', sheetName: 'VH1_HOA', requestType: 'Hóa' },\n  DIEN: { spreadsheetId: '1nPKFBr3wXfOFE4y_WACDs7cvb1ZZA-mg0mZbsIuB_lQ', sheetName: 'DH1', requestType: 'Điện' },\n  DIEN_MT: { spreadsheetId: '1nPKFBr3wXfOFE4y_WACDs7cvb1ZZA-mg0mZbsIuB_lQ', sheetName: 'DH1 qt OL', requestType: 'Môi Trường' },\n};\nconst groups = new Map();\nfor (const event of events) {\n  const requestType = normalize(event.payload?.requestType);\n  const sourceSheet = normalize(event.payload?.sourceSheetName);\n  const sourceSpreadsheetId = String(event.payload?.sourceSpreadsheetId ?? '').trim();\n  let key;\n  if (sourceSpreadsheetId === '1nPKFBr3wXfOFE4y_WACDs7cvb1ZZA-mg0mZbsIuB_lQ' && (sourceSheet.includes('qt ol') || requestType.includes('moi truong'))) key = 'DIEN_MT';\n  else if (sourceSpreadsheetId === '1zKRH9zhEAkCwGRl4KiaNwUlkLg9_l4WXNSBeg3FK_MA' && sourceSheet.includes('hoa')) key = 'CO_HOA';\n  else if (sourceSpreadsheetId === '1zKRH9zhEAkCwGRl4KiaNwUlkLg9_l4WXNSBeg3FK_MA' && sourceSheet.includes('mtruong')) key = 'CO_MT';\n  else if (requestType.includes('hoa')) key = 'CO_HOA';\n  else if (requestType.includes('moi truong')) key = sourceSpreadsheetId === '1nPKFBr3wXfOFE4y_WACDs7cvb1ZZA-mg0mZbsIuB_lQ' ? 'DIEN_MT' : 'CO_MT';\n  else if (requestType.includes('dien') || requestType.includes('i&c') || requestType.includes('hanh chinh it')) key = 'DIEN';\n  else key = 'CO';\n  if (!groups.has(key)) groups.set(key, { ...configs[key], events: [] });\n  groups.get(key).events.push(event);\n}\nreturn [...groups.values()].map(group => ({ json: { ...group, eventIds: group.events.map(event => event.id) } }));"
      },
      "id": "group-by-sheet",
      "name": "Gom sự kiện theo Sheet",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -420,
        80
      ]
    },
