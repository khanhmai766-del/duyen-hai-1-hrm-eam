      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "9OMe30YPXIQR7cIl",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://duyenhai1.vn/api/integrations/n8n/defects/outbox/batch/plan",
