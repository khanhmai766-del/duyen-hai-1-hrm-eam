# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/powerplant?schema=public"

# NextAuth v5
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_TRUST_HOST="true"

# Public base URL used for QR code generation
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cho phép n8n gửi snapshot theo batch vào backend.
N8N_DEFECT_SYNC_TOKEN="replace-with-a-dedicated-n8n-token"
# Tùy chọn: override nguồn pull-sync trong môi trường local/staging.
# Bỏ trống ở production để backend chỉ nhận hai Sheet chính thức.
N8N_DEFECT_CO_SPREADSHEET_ID=""
N8N_DEFECT_DIEN_SPREADSHEET_ID=""
# Token riêng cho n8n claim/ack hàng đợi ghi ngược Google Sheet.
# Nếu bỏ trống, backend tạm dùng N8N_DEFECT_SYNC_TOKEN để tương thích.
N8N_DEFECT_TWO_WAY_SYNC_TOKEN="replace-with-a-second-dedicated-n8n-token"
# Production Webhook để nút trên website yêu cầu n8n đồng bộ thủ công.
N8N_DEFECT_MANUAL_WEBHOOK_URL="https://n8n.example.com/webhook/defects-manual-sync-dh1"

# Token chỉ đọc để n8n lấy các phiếu vật tư thay đổi và ghi một chiều lên VT_DONGBO.
N8N_MATERIAL_SYNC_TOKEN="replace-with-a-dedicated-material-sync-token"

# Private S3-compatible storage for uploads/backups (server-side only)
S3_ENDPOINT="https://s3.example.com"
S3_REGION="auto"
S3_BUCKET="duyenhai1-uploads"
S3_ACCESS_KEY="replace-with-access-key"
S3_SECRET_KEY="replace-with-secret-key"
S3_PUBLIC_BASE_URL="https://s3.duyenhai1.vn/yen-nn-cbsxdh1"
S3_FORCE_PATH_STYLE="true"

# Audit S3: mỗi sự kiện là một part TXT (mỗi dòng là JSON) bất biến, gom thành file ngày bằng
# npm run audit:s3:compact -- YYYY-MM-DD
AUDIT_LOG_S3_ENABLED="false"
AUDIT_LOG_S3_PREFIX="audit-logs"

# Upload limits
USER_UPLOAD_MAX_FILE_MB="5"
USER_UPLOAD_MAX_ZIP_MB="100"
USER_IMPORT_MAX_FILE_MB="5"

# One-time user import/upload tool. Turn both off after initial production import.
USER_IMPORT_ENABLED="false"
NEXT_PUBLIC_USER_IMPORT_ENABLED="false"
