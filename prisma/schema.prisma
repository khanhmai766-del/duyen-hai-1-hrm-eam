// PowerPlant HRM & EAM — Prisma schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(cuid())
  name                String
  employeeId          String    @unique
  email               String    @unique
  workEmail           String?   @map("work_email")
  username            String?   @unique
  phone               String?
  avatarUrl           String?
  signatureUrl        String? // chữ ký số: PNG nền trong suốt (base64) hoặc URL ngoài
  avatarKey           String?   @map("avatar_key") // S3 object key, không lưu file thật trong DB
  signatureKey        String?   @map("signature_key") // S3 object key, không lưu signed URL cố định
  passwordHash        String
  mustChangePassword  Boolean   @default(false) @map("must_change_password")
  passwordChangedAt   DateTime  @default(now()) @map("password_changed_at")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedAt            DateTime? @map("locked_at")
  role                Role      @default(VIEWER)
  accessMode          String    @default("NORMAL") // NORMAL | DEFECT_READ_ONLY
  position            String? // e.g. "Lò trưởng S1", "I&C", "Trưởng ca"
  secondaryPosition   String? // chức vụ phụ 1
  secondaryPosition2  String? // chức vụ phụ 2
  currentPosition     String? // chức vụ hiện tại người dùng đang chọn để nhận thông báo/quyền theo cương vị
  department          String?
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())

  checkIns                CheckIn[]
  shiftAssignments        ShiftAssignment[]
  repairLogs              RepairLog[]              @relation("CreatedBy")
  approvedLogs            RepairLog[]              @relation("ApprovedBy")
  auditLogs               AuditLog[]
  operationEvents         OperationEvent[]         @relation("OpCreatedBy")
  hcGroups                HcGroup[]                @relation("HcGroupCreator")
  hcCheckIns              HcCheckIn[]              @relation("HcCheckInUser")
  announcements           Announcement[]           @relation("AnnouncementCreator")
  announcementReads       AnnouncementRead[]       @relation("AnnouncementReader")
  materialReplacements    MaterialReplacement[]    @relation("MrCreatedBy")
  materialReplacementLogs MaterialReplacementLog[] @relation("MrDoneBy")
  defects                 Defect[]                 @relation("DefectCreatedBy")
  defectHistories         DefectHistory[]          @relation("DefectHistoryCreatedBy")
  webAuthnCredentials     WebAuthnCredential[]
  forumPosts              ForumPost[]              @relation("ForumPostAuthor")
  forumReplies            ForumReply[]             @relation("ForumReplyAuthor")
  forumPostLikes          ForumPostLike[]          @relation("ForumPostLikeUser")
  forumReplyLikes         ForumReplyLike[]         @relation("ForumReplyLikeUser")
  shnPpaRecords           ShnPpaRecord[]
  shnPpaToolVersions      ShnPpaToolVersion[]

  @@index([position])
  @@index([role])
  @@index([isActive])
}

// Ảnh chụp kết quả tiện ích SHN/PPA; không lưu file Excel gốc.
// Mỗi bản ghi tự hết hạn sau 30 ngày để phục vụ tra cứu ngắn hạn.
model ShnPpaRecord {
  id          String   @id @default(cuid())
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Cascade)
  fileNames   String[]
  month       Int?
  year        Int?
  dayFrom     Int?
  dayTo       Int?
  syncStatus  String   @default("UNKNOWN") // SUCCESS | PARTIAL | FAILED | SAVED | UNKNOWN
  syncMessage String?
  resultCount Int      @default(0)
  snapshot    Json
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@index([createdAt])
  @@index([expiresAt])
  @@index([createdById, createdAt])
  @@map("shn_ppa_records")
}

// Các phiên bản HTML của tiện ích do ADMIN tải lên. Nội dung chạy trong iframe
// sandbox; chỉ một phiên bản được đánh dấu active tại một thời điểm.
model ShnPpaToolVersion {
  id           String   @id @default(cuid())
  fileName     String
  content      String   @db.Text
  contentHash  String   @unique
  isActive     Boolean  @default(false)
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([isActive, createdAt])
  @@index([uploadedById, createdAt])
  @@map("shn_ppa_tool_versions")
}

model WebAuthnCredential {
  id           String    @id @default(cuid())
  credentialId String    @unique
  publicKey    String
  counter      Int       @default(0)
  userId       String
  deviceName   String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Bảng tin nội bộ: bài đăng do Quản trị (ADMIN) tạo, mọi người chỉ xem.
model Announcement {
  id             String    @id @default(cuid())
  category       String    @default("BULLETIN") // BULLETIN (bảng tin) | ORDER (mệnh lệnh sản xuất)
  classification String? // phân loại: Vận hành | An toàn vệ sinh lao động
  stt            String? // số thứ tự (tuỳ chọn), vd "01"
  title          String
  body           String
  pinned         Boolean   @default(false)
  orderedBy      String? // "Theo lệnh" — tên quản đốc / phó quản đốc ra lệnh
  issuedAt       DateTime? // ngày ra mệnh lệnh
  invalidatedAt  DateTime? // ngày đánh dấu mệnh lệnh không còn hiệu lực; tự xoá sau 15 ngày
  linkUrl        String? // optional website link
  fileUrl        String? // optional attached PDF (public URL)
  fileName       String? // original PDF file name
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  createdBy User               @relation("AnnouncementCreator", fields: [createdById], references: [id])
  reads     AnnouncementRead[]

  @@index([category, pinned, createdAt])
  @@index([pinned, issuedAt, createdAt]) // khớp orderBy của GET /api/announcements
  @@index([createdById])
}

// Xác nhận đã đọc thông báo / mệnh lệnh của từng user.
model AnnouncementRead {
  id             String   @id @default(cuid())
  announcementId String
  userId         String
  readAt         DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation("AnnouncementReader", fields: [userId], references: [id])

  @@unique([announcementId, userId])
}

model ForumPost {
  id              String    @id @default(cuid())
  title           String
  content         String
  category        String    @default("DISCUSSION")
  tags            String[]
  attachments     String[]
  targetPositions String[]  @default([])
  isPinned        Boolean   @default(false)
  closeSummary    String?
  closedAt        DateTime?
  closedById      String?
  authorId        String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  author  User            @relation("ForumPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  replies ForumReply[]
  likes   ForumPostLike[]
}

model ForumReply {
  id            String   @id @default(cuid())
  postId        String
  parentReplyId String?
  content       String
  attachments   String[]
  authorId      String
  createdAt     DateTime @default(now())

  post         ForumPost        @relation(fields: [postId], references: [id], onDelete: Cascade)
  parentReply  ForumReply?      @relation("ForumReplyThread", fields: [parentReplyId], references: [id], onDelete: SetNull)
  childReplies ForumReply[]     @relation("ForumReplyThread")
  author       User             @relation("ForumReplyAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  likes        ForumReplyLike[]

  @@index([parentReplyId])
}

model ForumPostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User      @relation("ForumPostLikeUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model ForumReplyLike {
  id        String   @id @default(cuid())
  replyId   String
  userId    String
  createdAt DateTime @default(now())

  reply ForumReply @relation(fields: [replyId], references: [id], onDelete: Cascade)
  user  User       @relation("ForumReplyLikeUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([replyId, userId])
  @@index([userId])
}

model OperationEvent {
  id          String   @id @default(cuid())
  type        String // DRILL_INCIDENT, DRILL_FIRE, OTHER
  title       String
  date        DateTime
  note        String?
  createdById String
  createdAt   DateTime @default(now())

  createdBy User @relation("OpCreatedBy", fields: [createdById], references: [id])

  @@index([date])
  @@index([createdById])
}

enum Role {
  ADMIN
  MANAGER
  SUPERVISOR
  TECHNICIAN
  VIEWER
}

enum ActivityLogCategory {
  SYSTEM
  SECURITY
  ATTENDANCE
  USER
}

model Shift {
  id                 String    @id @default(cuid())
  date               DateTime
  shiftType          ShiftType
  unit               String // "Vận hành 1", "Vận hành 2"
  isAttendanceLocked Boolean   @default(false) @map("is_attendance_locked")

  assignments ShiftAssignment[]
  checkIns    CheckIn[]
  handovers   ShiftHandover[]

  @@index([date, shiftType])
  @@index([unit, date])
}

enum ShiftType {
  MORNING
  AFTERNOON
  NIGHT
}

model ShiftAssignment {
  id            String  @id @default(cuid())
  shiftId       String
  userId        String
  positionLabel String // display label in org chart
  parentId      String? // for org chart hierarchy
  isApproved    Boolean @default(false)

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@index([shiftId])
  @@index([userId])
  @@index([parentId])
}

model CheckIn {
  id         String    @id @default(cuid())
  userId     String
  shiftId    String
  checkInAt  DateTime?
  checkOutAt DateTime?
  status     String // PRESENT, ABSENT, LATE
  note       String?
  approvedBy String?

  user  User  @relation(fields: [userId], references: [id])
  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([shiftId])
  @@index([status])
}

model ShiftHandover {
  id         String   @id @default(cuid())
  shiftId    String
  fromUserId String
  toUserId   String
  handoverAt DateTime
  notes      String?
  issues     String? // outstanding issues passed over

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
}

model RepairLog {
  id           String       @id @default(cuid())
  deviceSeq    String
  machine      String       @default("COMMON") // S1 | S2 | COMMON; cây thiết bị dùng chung theo deviceSeq
  title        String
  description  String
  symptom      String?
  cause        String?
  action       String
  result       String?
  startedAt    DateTime
  completedAt  DateTime?
  status       RepairStatus @default(OPEN)
  priority     Priority     @default(MEDIUM)
  cost         Float?
  downtime     Int? // minutes
  createdById  String
  approvedById String?
  attachments  String[] // file URLs
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  device     EquipmentNode @relation(fields: [deviceSeq], references: [seq], onDelete: Cascade)
  createdBy  User          @relation("CreatedBy", fields: [createdById], references: [id])
  approvedBy User?         @relation("ApprovedBy", fields: [approvedById], references: [id])

  // Lọc theo riêng deviceSeq dùng chung index [deviceSeq, machine] — B-tree phục vụ
  // được mọi tiền tố cột, nên không cần index đơn [deviceSeq] nữa.
  @@index([deviceSeq, machine])
  // Index prefix cho truy vấn cả nhánh cây: WHERE deviceSeq LIKE '1.2.%'
  @@index([deviceSeq(ops: raw("text_pattern_ops"))], map: "repairlog_deviceseq_prefix")
  @@index([deviceSeq, startedAt])
  @@index([status])
  @@index([createdById])
  @@index([startedAt])
}

enum RepairStatus {
  OPEN
  IN_PROGRESS
  WAITING_PARTS
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Material {
  id           String   @id @default(cuid())
  code         String
  erpCodes     String[] @default([])
  name         String
  unit         String
  quantity     Int      @default(0)
  minStock     Int      @default(0)
  location     String?
  system       String? // hệ thống thiết bị: Lò Hơi, Máy Nghiền, ESP, FGD...
  category     String? // loại vật tư: Dầu bôi trơn, Bi nghiền than, Lõi lọc dầu, Thiết bị C&I, Vật tư tiêu hao
  machine      String   @default("COMMON") // tổ máy sở hữu danh mục: S1 | S2 | COMMON
  imageUrl     String? // ảnh minh hoạ vật tư (public URL)
  documentUrl  String? // tài liệu đính kèm (PDF hoặc link)
  documentName String? // tên file tài liệu đính kèm
  supplier     String? // tái dùng làm "Định kỳ thay thế"
  unitPrice    Float?
  note         String? // "Ghi chú"
  createdAt    DateTime @default(now())

  deviceMaterials EquipmentMaterial[]
  replacements    MaterialReplacement[]
  ticketItems     MaterialTicketItem[]
  defectRequests  DefectMaterialRequest[]
  replacementLogs MaterialReplacementLog[]
  stockMovements  MaterialStockMovement[]
  annualPlans     MaterialAnnualPlan[]

  @@unique([code, machine])
  @@index([system])
  @@index([quantity])
  @@index([machine])
}

// Chỉ tiêu kế hoạch năm theo biểu QLVT.20. Khoá nghiệp vụ dùng LOẠI VẬT TƯ + TÊN
// CHỮ đã chuẩn hoá, không dùng STT hoặc ép theo mã ERP: một tên có thể chưa được cấp
// mã, và cùng mã có thể xuất hiện trên nhiều dòng mục đích sử dụng trong biểu nguồn.
model MaterialAnnualPlan {
  id                String   @id @default(cuid())
  year              Int
  materialCategory  String
  materialNameKey   String
  materialNameLabel String
  erpCode           String?
  materialId        String?
  unitLabel         String
  plannedQuantity   Decimal  @db.Decimal(18, 4)
  note              String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  material Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)

  @@unique([year, materialCategory, materialNameKey])
  @@index([year, materialCategory])
  @@index([erpCode])
  @@index([materialId])
}

/// Nhu cầu vật tư THEO THÁNG — cột H (số lượng yêu cầu) và cột J (mục đích, vị trí sử dụng)
/// của biểu QLVT.20.
///
/// Đây là HAI cột duy nhất người dùng còn phải nhập tay. Các cột còn lại của biểu đều do hệ
/// thống tự sinh: E từ `MaterialAnnualPlan`, F từ `MaterialReplacementLog`, G = E − F (tính chứ
/// không lưu), I/K từ `MaterialStockLot`, lưới T1..T12 từ chính phần thực dùng.
///
/// KHÔNG khoá duy nhất theo vật tư: một mã vật tư có nhiều dòng trong cùng một tháng, mỗi dòng
/// một mục đích sử dụng — đúng như biểu gốc đang làm.
model MaterialMonthlyRequest {
  id        String @id @default(cuid())
  // "YYYY-MM" theo giờ Việt Nam, cùng quy ước chốt kỳ với sổ hóa chất (`periodKeyOf`).
  periodKey String

  // Khoá nghiệp vụ trùng với `MaterialAnnualPlan` để ghép được chỉ tiêu năm vào dòng tháng.
  materialCategory  String
  materialNameKey   String
  materialNameLabel String
  erpCode           String?
  unitLabel         String

  purpose      String // cột J — mục đích, vị trí sử dụng
  quantity     Decimal @db.Decimal(18, 4) // cột H — số lượng yêu cầu trong tháng
  proposerName String? // cột L — người đề xuất
  note         String?

  createdById   String
  createdByName String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([periodKey, materialCategory])
  @@index([materialCategory, materialNameKey])
}

model ErpMaterial {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  unit      String
  erpStock  Float    @default(0)
  category  String?
  warehouse String? // Kho VTTB — kho vật tư thiết bị theo ERP
  note      String?
  isActive  Boolean  @default(true) // false = ngừng sử dụng; giữ lại để bảo toàn lịch sử phiếu
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- gom nhóm theo loại dầu (module tồn kho theo loại dầu) ---
  // Import Excel ERP chỉ update name/unit/category/erpStock nên mapping đã
  // duyệt không bị reset sau mỗi lần nhập (cơ chế "học dần").
  oilTypeId        String?
  oilType          OilType?      @relation(fields: [oilTypeId], references: [id])
  mappingStatus    MappingStatus @default(UNMAPPED)
  conversionFactor Float         @default(1) // 1 unit gốc = ? baseUnit (vd 1 phuy = 209 Lít)

  // gợi ý đang chờ duyệt (null sau khi CONFIRMED/IGNORED)
  suggestedOilTypeId String?
  suggestedScore     Float?
  suggestedReason    String?

  mappingLogs OilTypeMappingLog[]

  @@index([code])
  @@index([category])
  @@index([erpStock])
  @@index([mappingStatus])
  @@index([oilTypeId])
}

// Điểm thay thế của một vật tư: vật tư này thay cho 1 thiết bị (hoặc 1 vị trí
// tự do) theo chu kỳ riêng. Dùng để theo dõi & cảnh báo thời điểm thay thế.
model MaterialReplacement {
  id                   String    @id @default(cuid())
  materialId           String
  deviceSeq            String? // thiết bị theo EquipmentNode.seq (tuỳ chọn)
  machine              String    @default("COMMON") // Tổ máy: S1 | S2 | COMMON — lịch thay thế theo hồ sơ tổ máy
  location             String? // vị trí/ứng dụng tự do (tuỳ chọn) — dùng khi không gắn thiết bị
  system               String? // hệ thống thiết bị (mặc định theo vật tư), vd "Máy Nghiền"
  quantity             Int       @default(1) // dung tích/số lượng cần thay CHO MỖI thiết bị (theo ĐVT của vật tư)
  deviceCount          Int       @default(1) // số lượng thiết bị tại điểm này
  managingPosition     String? // cương vị quản lý (đồng bộ danh sách với form khiếm khuyết)
  managingPositionCode String? // mã cương vị ổn định; giữ managingPosition làm nhãn tương thích dữ liệu cũ
  intervalMonths       Int // chu kỳ thay thế (tháng); 0 = chỉ khai báo, không theo dõi lịch
  intervalNote         String? // ghi chú chu kỳ, vd "2500h"
  // Vật tư theo O&M chỉ LẤY MẪU/theo dõi/châm bổ sung chứ không thay định kỳ.
  // Vẫn có chu kỳ và vẫn nhắc đến hạn, nhưng hiển thị riêng và không cộng vào
  // cảnh báo quá hạn thay thế để khỏi làm loãng cảnh báo thật.
  samplingOnly         Boolean   @default(false)
  // Khi chọn lý do "Bổ sung", điểm này vẫn phải lập biên bản vật tư thu hồi.
  recoveryOnSupplement Boolean   @default(false)
  lastReplacedAt       DateTime? // lần thay gần nhất (user nhập)
  nextDueAt            DateTime // ngày đến hạn kế tiếp
  note                 String?
  isActive             Boolean   @default(true)
  // Đã sinh chu kỳ kế tiếp cho điểm này hay chưa. Một điểm có thể được cấp vật tư nhiều đợt
  // (lãnh hai lần cho cùng một lần thay), mỗi đợt là một phiếu và một dòng lịch sử — nhưng
  // CHU KỲ CHỈ ĐƯỢC GIA HẠN MỘT LẦN. Lần quyết toán sau thấy cột này đã có giá trị thì chỉ
  // ghi lịch sử, không tạo điểm mới nữa.
  renewalAppliedAt     DateTime?
  // Công tắc tự động gia hạn. Tắt cho những điểm có chu kỳ thực tế lệch nhiều so với khai
  // báo — khi đó vẫn ghi lịch sử nhưng để người dùng tự khai lại chu kỳ mới.
  autoRenew            Boolean   @default(true)
  createdById          String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  material       Material                    @relation(fields: [materialId], references: [id], onDelete: Cascade)
  device         EquipmentNode?              @relation(fields: [deviceSeq], references: [seq], onDelete: SetNull)
  createdBy      User                        @relation("MrCreatedBy", fields: [createdById], references: [id])
  logs           MaterialReplacementLog[]
  // Các SYC thay thế đã ra cho chính điểm khai báo này.
  defectRequests DefectMaterialRequest[]
  // Các phiếu vật tư phục vụ điểm này — xem model MaterialTicketReplacement.
  ticketLinks    MaterialTicketReplacement[]

  @@index([deviceSeq])
  // Index prefix cho truy vấn cả nhánh cây: WHERE deviceSeq LIKE '1.2.%'
  @@index([deviceSeq(ops: raw("text_pattern_ops"))], map: "matrep_deviceseq_prefix")
  @@index([materialId])
  @@index([system])
  @@index([managingPositionCode])
  @@index([isActive, nextDueAt])
  @@index([createdById])
}

// Lịch sử mỗi lần thay thế vật tư tại một điểm thay thế.
model MaterialReplacementLog {
  id            String   @id @default(cuid())
  // Liên kết MỀM tới điểm thay thế: điểm theo dõi có vòng đời riêng (bị gỡ sau mỗi
  // lần ghi nhận, có thể bị xoá khi khai báo lại) nhưng lịch sử thì phải bất biến.
  // Vì vậy nullable + SetNull, và mọi thứ cần để hiển thị đều nằm ở snapshot dưới.
  replacementId String?
  replacedAt    DateTime @default(now())
  doneById      String
  quantity      Int?
  note          String?

  // Snapshot tại thời điểm ghi nhận — đủ để dòng lịch sử tự đứng một mình.
  materialId       String?
  deviceSeq        String? // mã thiết bị trên cây, giữ cả khi điểm đã bị gỡ
  machine          String? // S1 | S2 | COMMON
  systemLabel      String? // "TRẠM DẦU BÔI TRƠN HP-LP"
  deviceLabel      String? // "Bồn dầu LP/HP thùng nghiền A"
  managingPosition String?
  intervalMonths   Int?
  intervalNote     String?
  unitLabel        String? // ĐVT vật tư: "Lít", "Cái"…
  // Nguồn gốc: rỗng nếu ghi thủ công, có số yêu cầu nếu sinh từ SYC thay thế vật tư.
  defectId         String?
  requestNumber    String?

  // --- Số liệu THỰC TẾ, ghi tại bước quyết toán của phiếu vật tư (giai đoạn 3) ---
  // `quantity` phía trên là số KẾ HOẠCH khi dòng do SYC sinh ra (= quantity × deviceCount
  // của điểm). `usedQuantity` mới là khối lượng đã tiêu thụ thật, và là con số DUY NHẤT
  // được dùng để tính luỹ kế sử dụng cho biểu dự toán năm QLVT.20.
  ticketId           String? // phiếu vật tư đã ghi dòng này; null = dòng do SYC hoặc nhập tay
  usedQuantity       Int?
  // Vật tư dùng cho việc PHÁT SINH ngoài lịch (phiếu không gắn điểm thay thế nào).
  //
  // Phải là cột riêng chứ không suy từ `replacementId = null`: dòng ĐỊNH KỲ cũng có
  // `replacementId = null` khi điểm đã hết chu kỳ đang theo dõi tại lúc quyết toán. Dự toán năm
  // sau tách "nhu cầu định kỳ" khỏi "bình quân phát sinh" nên hai loại phải phân biệt được chắc
  // chắn, không dựa vào dấu hiệu gián tiếp.
  unplanned          Boolean @default(false)
  bbntDoNumber       String?
  bbntDoUrl          String?
  proposalNumber     String? // số phiếu ĐXVT
  deliveryNoteNumber String? // số phiếu giao hàng của lô đã dùng

  // --- Dữ liệu LƯU TRỮ nhập từ Google Sheet theo dõi vật tư (07.2025 → 08.2026) ---
  // Chỉ để TRA CỨU: các dòng này không gắn điểm theo dõi (replacementId = null) nên
  // không đụng vào luồng ghi nhận thay thế đang chạy trên web.
  // `importSource` khác null = dòng lưu trữ; null = dòng do web tự sinh như trước.
  importSource      String? // vd "SHEET_VT"
  importKey         String? // khoá chống trùng khi chạy lại: "<tab>|<dòng>"
  pctNumber         String? // Số PCT/LCT sử dụng vật tư
  sourceNote        String? // Ghi chú gộp: số BBNT DO + hình thức lãnh
  materialCategory  String? // Dầu bôi trơn | Lõi lọc dầu | Bi Nghiền Than | Hóa Chất
  // Tên vật tư dạng CHỮ: Sheet dùng danh mục rộng hơn Danh mục Vận Hành 1 nên phần lớn
  // dòng lưu trữ không tra được materialId; giữ nguyên văn để bảng vẫn hiển thị đủ.
  materialNameLabel String?
  // Tên người sử dụng nguyên văn trên Sheet. Dùng khi không tìm được tài khoản
  // (người đã nghỉ việc, ô bỏ trống) — doneById là khoá ngoại BẮT BUỘC nên không rỗng được.
  doneByName        String?

  replacement MaterialReplacement? @relation(fields: [replacementId], references: [id], onDelete: SetNull)
  material    Material?            @relation(fields: [materialId], references: [id], onDelete: SetNull)
  doneBy      User                 @relation("MrDoneBy", fields: [doneById], references: [id])

  // Chạy lại script nhập không được tạo bản sao: khoá duy nhất theo nguồn + vị trí dòng.
  @@unique([importSource, importKey])
  // Một phiếu chỉ ghi ĐÚNG MỘT dòng cho mỗi điểm: gọi lại tác vụ quyết toán bao nhiêu lần
  // cũng không sinh dòng thứ hai. Đây là khoá idempotent của giai đoạn 3.
  // Dòng do SYC/nhập tay sinh có ticketId = null nên không dính ràng buộc này (Postgres coi
  // mỗi NULL là khác nhau trong unique index).
  @@unique([replacementId, ticketId])
  // Lịch sử "các lần thay tại điểm X, mới nhất trước" đọc thẳng từ index; lọc theo
  // riêng replacementId cũng dùng chính index này (tiền tố cột đầu).
  @@index([replacementId, replacedAt(sort: Desc)])
  @@index([doneById])
  @@index([replacedAt])
  // Lịch sử thay thế của một thiết bị / một vật tư, đọc thẳng từ index kể cả khi
  // điểm theo dõi đã bị gỡ (replacementId = null).
  @@index([deviceSeq, replacedAt(sort: Desc)])
  @@index([materialId])
  @@index([defectId])
  @@index([importSource, replacedAt(sort: Desc)])
  @@index([unplanned, replacedAt(sort: Desc)])
  @@index([ticketId])
}

// Cầu nối "Chi tiết điểm thay thế" (Danh mục vật tư) → Số yêu cầu khiếm khuyết.
// Một SYC có thể phủ NHIỀU điểm cùng tổ máy + cùng cương vị (vd 6 bồn dầu LP/HP).
//
// quantity/unitLabel/pointLabel là SNAPSHOT lúc ra phiếu, cố ý không đọc lại qua
// quan hệ: phiếu đã đẩy lên Google Sheet thì nội dung phải bất biến kể cả khi
// điểm khai báo bị sửa hoặc xoá sau đó (replacementId khi đó chỉ bị SetNull).
model DefectMaterialRequest {
  id            String   @id @default(cuid())
  defectId      String
  replacementId String?
  materialId    String
  quantity      Int      @default(0) // = quantity × deviceCount của điểm, theo ĐVT vật tư
  unitLabel     String   @default("") // ĐVT snapshot: "Lít", "Cái"…
  pointLabel    String   @default("") // "TRẠM DẦU BÔI TRƠN HP-LP · Bồn dầu LP/HP thùng nghiền A"
  createdAt     DateTime @default(now())

  defect      Defect               @relation(fields: [defectId], references: [id], onDelete: Cascade)
  replacement MaterialReplacement? @relation(fields: [replacementId], references: [id], onDelete: SetNull)
  material    Material             @relation(fields: [materialId], references: [id])

  // Một điểm chỉ được gắn một lần vào cùng một phiếu.
  @@unique([defectId, replacementId])
  @@index([defectId])
  @@index([replacementId])
  @@index([materialId])
}

model EquipmentMaterial {
  id         String   @id @default(cuid())
  deviceSeq  String
  machine    String   @default("COMMON") // Tổ máy: S1 | S2 | COMMON — vật tư dùng theo hồ sơ tổ máy trên cây chung
  materialId String
  quantity   Int
  usedAt     DateTime @default(now())
  note       String?

  device   EquipmentNode @relation(fields: [deviceSeq], references: [seq], onDelete: Cascade)
  material Material      @relation(fields: [materialId], references: [id])

  // Lịch sử "vật tư đã dùng cho thiết bị X, mới nhất trước" đọc thẳng từ index; lọc
  // theo riêng deviceSeq cũng dùng chính index này (tiền tố cột đầu).
  @@index([deviceSeq, usedAt(sort: Desc)])
  @@index([materialId])
}

// Khiếm khuyết thiết bị (Defect) — phiếu ghi nhận khiếm khuyết theo tổ máy/hệ thống.
model Defect {
  id                         String    @id @default(cuid())
  unit                       String // Tổ máy: S1 | S2
  commonSubUnit              String? // Khi unit = COMMON: BOP | CHUNG | ĐKTT — giữ nhãn Tổ máy gốc từ Sheet
  deviceSeq                  String? // Khóa liên kết chuẩn với cây thiết bị (EquipmentNode.seq)
  mappedDeviceUnit           String? // hồ sơ thiết bị được ánh xạ: S1 | S2 | COMMON; độc lập với unit của phiếu
  device                     String? // Thiết bị (mã thiết bị) — giữ lại tạm để tương thích dữ liệu cũ
  system                     String? // Cương vị (chức vụ phụ trách)
  positionCode               String? // mã cương vị ổn định; system/sourcePositionRaw giữ nhãn gốc để hiển thị và đối soát
  severity                   String? // Mức độ: "1".."4"
  severityCriteria           String[]  @default([]) // Các ID tiêu chí chi tiết đã chọn theo mức độ
  condition                  String? // Điều kiện thực hiện: A | B
  fireSafetyImpact           String? // Ảnh hưởng PCCC: Có | Không
  environmentSafetyImpact    String? // Môi trường, ATVSLĐ: Có | Không
  requestType                String? // Yêu cầu: Cơ | Điện | I&C | Khác
  requestNumber              String? // Số yêu cầu STT/năm; dữ liệu Sheet cũ có thể trùng giữa/và trong nguồn
  content                    String? // Nội dung
  status                     String    @default("CHUA_XU_LY") // Tình trạng khiếm khuyết
  detectedAt                 DateTime? // Ngày phát hiện
  reminderCount              Int       @default(0) // Số lần nhắc lại
  lastRemindedAt             DateTime? // Thời điểm nhắc lại gần nhất
  reminderRaw                String? // Nội dung nhắc lại nguyên văn từ nguồn
  repeatedRepairRaw          String? // Nội dung sửa chữa lặp lại nguyên văn từ nguồn
  sourceType                 String    @default("MANUAL") // MANUAL | GOOGLE_SHEETS
  websiteCreated             Boolean   @default(false) // Phiếu khởi tạo trên website, giữ quyền Nhắc lại/Hoàn thành sau khi liên kết Sheet
  sourceKey                  String?   @unique // Khóa chống trùng ổn định của dòng nguồn
  sourceSpreadsheetId        String?
  sourceSheetName            String?
  sourceRow                  Int?
  sourceDeviceRaw            String? // Tên thiết bị nguyên văn trên Google Sheet
  sourcePositionRaw          String? // Cương vị nguyên văn trên Google Sheet
  sourceStatusRaw            String? // Trạng thái nguyên văn trên Google Sheet
  ktatReviewRaw              String? // KTAT rà soát (16)
  boardDirectionRaw          String? // BGĐ chỉ đạo (17)
  repairOrderNumberRaw       String? // Số PCT/LCT (18) do bộ phận sửa chữa cập nhật
  repairSolutionRaw          String? // Giải pháp sửa chữa (19)
  repairPlanRaw              String? // Kế hoạch thực hiện (20)
  repairUnitRaw              String? // Đơn vị sửa chữa (21)
  repairResultRaw            String? // Kết quả thực hiện (22) do bộ phận sửa chữa cập nhật
  repairPerformedByRaw       String? // Người thực hiện (23)
  repairStartedAt            DateTime? // Ngày thực hiện (24)
  sourceStatusMismatch       Boolean   @default(false) // Kết quả sửa chữa khác tình trạng VH1
  sourceCompletedAt          DateTime? // Ngày kết thúc theo Google Sheet (25)
  repairPerformedContentRaw  String? // Nội dung đã thực hiện (26)
  repairNoteRaw              String? // Ghi chú sửa chữa (27)
  sourceHash                 String? // Dấu kiểm tra nội dung nguồn
  sourceSyncedAt             DateTime?
  sourceLastSeenAt           DateTime?
  sourceChangedAfterConfirm  Boolean   @default(false)
  syncState                  String    @default("ACTIVE") // ACTIVE | CONFIRMED | MISSING
  postRepairAwaitingMaterial Boolean   @default(false) // VHV giữ phiếu đã xử lý ở Tồn đọng do còn chờ vật tư
  // Phiếu ra số để THAY THẾ VẬT TƯ, sinh từ "Chi tiết điểm thay thế" của Danh mục vật tư.
  // Cờ phẳng để danh sách gắn nhãn/lọc mà không phải join DefectMaterialRequest.
  isMaterialRequest          Boolean   @default(false)
  confirmedAt                DateTime?
  confirmedById              String? // Snapshot ID người xác nhận, không FK
  confirmedByName            String? // Snapshot tên người xác nhận
  confirmedHistoryId         String? // ID lịch sử đã sinh
  cancelledAt                DateTime? // VHV hủy phiếu; không xóa vật lý để giữ liên kết đồng bộ hai chiều
  cancelledById              String? // Snapshot ID người hủy, không FK
  cancelledByName            String? // Snapshot tên người hủy
  requestNumberReleasedAt    DateTime? // STT hủy trong cửa sổ 6 giờ được trả lại kho sau khi Sheet ACK
  requestNumberReusedAt      DateTime? // STT đã được một phiếu mới nhận lại
  requestNumberReusedById    String? // Snapshot ID phiếu mới nhận lại STT, không FK
  requestNumberReuseEligible Boolean   @default(false) // Chỉ phiếu hủy sau khi triển khai cơ chế mới được tái sử dụng STT
  shiftLeaderId              String? // Người giữ cương vị Trưởng ca tại thời điểm lập phiếu (không FK để giữ snapshot)
  shiftLeaderName            String? // Tên Trưởng ca snapshot, giữ nguyên nếu nhân sự đổi cương vị/tài khoản
  completedAt                DateTime? // Ngày đánh dấu "Đã xử lý" — dùng cho mốc ẩn khỏi danh sách sau 2 tuần
  note                       String? // Ghi chú
  imageUrl                   String? // Ảnh cũ (giữ để tương thích dữ liệu trước khi hỗ trợ nhiều ảnh)
  images                     String[]  @default([]) // Ảnh ghi nhận ban đầu cho mọi mức độ; giới hạn theo MAX_DEFECT_IMAGES
  createdById                String
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  createdBy        User                    @relation("DefectCreatedBy", fields: [createdById], references: [id])
  node             EquipmentNode?          @relation(fields: [deviceSeq], references: [seq], onDelete: SetNull)
  relatedDevices   DefectRelatedDevice[]
  pendingHistory   DefectHistoryPending?
  reminderLogs     DefectReminderLog[]
  materialRequests DefectMaterialRequest[]
  // Phiếu vật tư đã ra SYC này. Quan hệ đặt tên vì Defect còn nối MaterialTicket qua
  // DefectMaterialRequest ở trên, Prisma cần phân biệt hai đường.
  materialTickets  MaterialTicket[]        @relation("MaterialTicketDefect")

  @@index([positionCode])
  // Bảng này phình nhanh nhất (mỗi ca trực đẻ thêm phiếu) nên chỉ giữ index KHÔNG
  // trùng nhau: B-tree phục vụ được mọi tiền tố cột, nên [deviceSeq], [status] và
  // [unit, status] đã nằm trong ba index composite ngay dưới đây.
  //
  // Lịch sử "khiếm khuyết của thiết bị X, mới nhất trước" đọc thẳng từ index.
  @@index([deviceSeq, createdAt(sort: Desc)])
  // Index prefix cho truy vấn cả nhánh cây: WHERE deviceSeq LIKE '1.2.%'
  @@index([deviceSeq(ops: raw("text_pattern_ops"))], map: "defect_deviceseq_prefix")
  @@index([device])
  @@index([system])
  @@index([detectedAt])
  @@index([shiftLeaderId])
  @@index([createdAt])
  @@index([completedAt])
  @@index([cancelledAt])
  @@index([requestType, requestNumberReleasedAt, requestNumberReusedAt])
  @@index([status, completedAt(sort: Desc)])
  @@index([createdById])
  @@index([sourceType, syncState])
  // Snapshot từng nguồn chỉ quét và đánh dấu thiếu trong đúng Google Sheet vừa đồng bộ.
  @@index([sourceSpreadsheetId, syncState])
  @@index([requestNumber])
  // Trang khiếm khuyết: lọc tổ máy/trạng thái nguồn và ưu tiên đối chiếu + ngày phát hiện.
  @@index([unit, sourceType, syncState])
  @@index([unit, status, severity])
  // Trang khiếm khuyết mặc định lọc tổ máy + loại yêu cầu rồi sắp mới nhất.
  @@index([unit, requestType, detectedAt(sort: Desc)])
  @@index([unit, requestType, status, severity])
  @@index([sourceStatusMismatch, detectedAt(sort: Desc)])
  @@index([unit, deviceSeq])
}

// Bản nháp lịch sử của phiếu Google Sheet sau khi VHV xác nhận.
// Trong 14 ngày chờ, Defect vẫn ACTIVE để nhận dữ liệu sửa chữa mới từ n8n.
model DefectHistoryPending {
  id              String   @id @default(cuid())
  defectId        String   @unique
  workOrderNumber String?
  requestType     String?
  performedAt     DateTime
  content         String?
  result          String?
  confirmedById   String // Snapshot ID người xác nhận, không FK
  confirmedByName String // Snapshot tên người xác nhận
  startedAt       DateTime @default(now())
  finalizeAt      DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  defect Defect @relation(fields: [defectId], references: [id], onDelete: Cascade)

  @@index([finalizeAt])
}

// Ngày của từng lần nhắc lại kể từ khi tính năng này được triển khai. Luôn ghi
// độc lập với cờ tích hợp để dữ liệu nghiệp vụ đầy đủ và có thể retry đồng bộ.
model DefectReminderLog {
  id              String   @id @default(cuid())
  defectId        String
  occurredAt      DateTime
  createdById     String // Snapshot ID người bấm nhắc lại, không FK
  shiftLeaderId   String? // Snapshot Trưởng ca được chọn cho riêng lần nhắc này
  shiftLeaderName String?
  createdAt       DateTime @default(now())

  defect Defect @relation(fields: [defectId], references: [id], onDelete: Cascade)

  @@index([defectId, occurredAt])
}

// Danh sách thiết bị liên quan của một phiếu khiếm khuyết.
// Thiết bị chính vẫn nằm ở Defect.deviceSeq để giữ nguyên phân quyền/cương vị phụ trách.
model DefectRelatedDevice {
  defectId   String
  deviceSeq  String
  mappedUnit String? // hồ sơ thiết bị liên quan: S1 | S2 | COMMON
  createdAt  DateTime @default(now())

  defect Defect        @relation(fields: [defectId], references: [id], onDelete: Cascade)
  device EquipmentNode @relation("DefectRelatedEquipment", fields: [deviceSeq], references: [seq], onDelete: Cascade)

  @@id([defectId, deviceSeq])
  @@index([deviceSeq])
}

// Lịch sử xử lý khiếm khuyết theo cương vị — sinh khi một khiếm khuyết được "Hoàn thành".
// Tách rời vòng đời Defect (không đặt FK) để phiếu khiếm khuyết có thể bị ẩn/xoá sau 2 tuần
// mà lịch sử vẫn được giữ lại.
model DefectHistory {
  id                String    @id @default(cuid())
  defectId          String? // nguồn (khiếm khuyết) — không ràng buộc quan hệ
  // Bản ghi sinh từ SYC thay thế vật tư: hiển thị ở tab "Lịch sử thay thế" của
  // trang Lịch thay thế vật tư, KHÔNG hiện ở Lịch sử sửa chữa.
  // Cờ phẳng chép lúc ghi, cùng lối với Defect.isMaterialRequest — vì defectId cố
  // ý không có quan hệ nên không lọc lồng qua Defect được. Không có cột này thì
  // mỗi lần mở Lịch sử sửa chữa phải nạp toàn bộ id SYC rồi lọc bằng NOT IN.
  isMaterialRequest Boolean   @default(false)
  unit              String // Tổ máy thực hiện (snapshot theo khiếm khuyết)
  deviceSeq         String? // Khóa liên kết chuẩn với cây thiết bị (EquipmentNode.seq) — dùng lọc quyền/nhánh bằng SQL
  mappedDeviceUnit  String? // snapshot hồ sơ thiết bị đã ánh xạ: S1 | S2 | COMMON
  device            String? // Thiết bị (mã thiết bị) — snapshot text, giữ lại khi node bị xóa
  system            String? // Cương vị (snapshot theo khiếm khuyết)
  requestType       String? // PCT (loại yêu cầu: Cơ | Điện | Hóa | …) — đồng bộ "Yêu Cầu"
  workOrderNumber   String? // Số phiếu công tác thực hiện
  performedAt       DateTime // Ngày thực hiện
  result            String? // Kết quả thực hiện
  defectContent     String? // Nội dung công tác từ phiếu khiếm khuyết (snapshot)
  content           String? // Nội dung thực hiện
  requestNumber     String? // Số yêu cầu (snapshot)
  reminderCount     Int       @default(0) // Số lần nhắc lại (snapshot)
  lastRemindedAt    DateTime? // Thời điểm nhắc lại gần nhất (snapshot)
  reminderRaw       String? // Nội dung nhắc lại nguyên văn tại lúc xác nhận
  sourceKey         String? // Khóa dòng Google Sheet nguồn
  sourceSnapshot    Json? // Bản chụp dữ liệu nguồn, không bị đồng bộ ghi đè
  images            String[] // Hình ảnh (tối đa 3)
  createdById       String
  createdAt         DateTime  @default(now())

  createdBy      User                         @relation("DefectHistoryCreatedBy", fields: [createdById], references: [id])
  node           EquipmentNode?               @relation(fields: [deviceSeq], references: [seq], onDelete: SetNull)
  relatedDevices DefectHistoryRelatedDevice[]

  // Lịch sử "của thiết bị X, mới nhất trước" đọc thẳng từ index; lọc theo riêng
  // deviceSeq cũng dùng chính index này (tiền tố cột đầu).
  @@index([deviceSeq, performedAt(sort: Desc)])
  // Index prefix cho truy vấn cả nhánh cây: WHERE deviceSeq LIKE '1.2.%'
  @@index([deviceSeq(ops: raw("text_pattern_ops"))], map: "defecthistory_deviceseq_prefix")
  @@index([device])
  @@index([system])
  @@index([performedAt])
  @@index([unit, performedAt])
  @@index([createdById])
}

model DefectSyncRun {
  id                    String            @id @default(cuid())
  startedAt             DateTime          @default(now())
  finishedAt            DateTime?
  status                String // RUNNING | SUCCESS | FAILED
  trigger               String // MANUAL | CRON | N8N
  externalRunId         String?           @unique // ID idempotency do n8n sinh cho một lượt full snapshot
  expectedSources       String[]          @default([]) // CO | DIEN
  completedSources      String[]          @default([])
  readCount             Int               @default(0)
  createdCount          Int               @default(0)
  updatedCount          Int               @default(0)
  unchangedCount        Int               @default(0)
  confirmedSkippedCount Int               @default(0)
  missingCount          Int               @default(0)
  error                 String?
  triggeredById         String?
  triggeredByName       String?
  batches               DefectSyncBatch[]
  seenKeys              DefectSyncSeen[]

  @@index([startedAt])
  @@index([status])
  @@index([status, startedAt(sort: Desc)])
}

// Một batch n8n được ghi lại để retry không làm tăng số liệu hoặc ghi trùng.
model DefectSyncBatch {
  id                    String   @id @default(cuid())
  runId                 String
  source                String // CO | DIEN
  batchNumber           Int
  status                String // PROCESSING | SUCCESS | FAILED
  recordCount           Int      @default(0)
  createdCount          Int      @default(0)
  updatedCount          Int      @default(0)
  unchangedCount        Int      @default(0)
  confirmedSkippedCount Int      @default(0)
  error                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  run DefectSyncRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, source, batchNumber])
  @@index([runId, status])
}

// Khóa nguồn đã xuất hiện trong một full snapshot; chỉ dùng đến lúc finish.
model DefectSyncSeen {
  runId      String
  sourceKey  String
  source     String
  sourceHash String
  createdAt  DateTime @default(now())

  run DefectSyncRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@id([runId, sourceKey])
  @@index([runId, source])
}

// Cờ bật/tắt khả năng đồng bộ HAI CHIỀU (DH1 ghi ngược lên Google Sheet) — dự phòng cho
// giai đoạn phát triển sau; hiện tại luồng đồng bộ chỉ đọc một chiều Sheet → DB.
// Bảng chỉ có một dòng duy nhất (id cố định "singleton"), mặc định tắt.
model DefectSyncSetting {
  id                     String   @id @default("singleton")
  twoWaySyncEnabled      Boolean  @default(false)
  operationUpdateEnabled Boolean  @default(true)
  websiteCreateEnabled   Boolean  @default(false)
  websiteRemindEnabled   Boolean  @default(false)
  updatedAt              DateTime @updatedAt
  updatedById            String?
  updatedByName          String?
}

// Bộ cấp STT phiếu khiếm khuyết theo năm phát hiện và loại phiếu. Cơ/Điện có
// dãy riêng, mỗi dãy bắt đầu lại từ 1 khi sang năm mới.
model DefectRequestSequence {
  year         Int
  requestType  String
  currentValue Int
  updatedAt    DateTime @updatedAt

  @@id([year, requestType])
}

// Transactional outbox cho chiều DH1 → Google Sheet. Không đặt FK với Defect để
// vẫn giữ được dấu vết/retry nếu phiếu được chuyển lịch sử hoặc xóa sau đó.
model DefectSyncOutbox {
  id            String    @id @default(cuid())
  defectId      String
  eventType     String // CREATE | UPDATE | REMIND
  payload       Json
  status        String    @default("PENDING") // PENDING | PROCESSING | SUCCESS | FAILED | SKIPPED
  attemptCount  Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  claimedAt     DateTime?
  completedAt   DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, nextAttemptAt, createdAt])
  @@index([defectId, createdAt])
}

// Snapshot danh sách thiết bị liên quan khi phiếu được chuyển sang lịch sử.
model DefectHistoryRelatedDevice {
  historyId  String
  deviceSeq  String
  mappedUnit String? // snapshot hồ sơ thiết bị liên quan: S1 | S2 | COMMON
  createdAt  DateTime @default(now())

  history DefectHistory @relation(fields: [historyId], references: [id], onDelete: Cascade)
  device  EquipmentNode @relation("DefectHistoryRelatedEquipment", fields: [deviceSeq], references: [seq], onDelete: Cascade)

  @@id([historyId, deviceSeq])
  @@index([deviceSeq])
}

model AuditLog {
  id        String              @id @default(cuid())
  userId    String
  action    String // e.g. "CREATE_DEVICE", "DELETE_REPAIR"
  category  ActivityLogCategory @default(USER)
  entity    String // e.g. "Device", "RepairLog"
  entityId  String?
  detail    String?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@index([createdAt])
}

model SystemAuditLog {
  id            String   @id @default(cuid())
  actorUserId   String
  actorName     String
  action        String
  targetType    String
  targetId      String?
  beforeData    Json?
  afterData     Json?
  changedFields String[]
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId])
  @@index([action])
  @@map("system_audit_logs")
}

// Chấm công hành chính: nhóm đi công tác hành chính (HC) theo ngày.
model HcGroup {
  id          String   @id @default(cuid())
  date        DateTime // ngày chấm công
  content     String // nội dung đi hành chính
  hours       Int      @default(8) // số giờ chấm công mặc định của nhóm
  period      String?  @default("FULL_DAY") // FULL_DAY | MORNING | AFTERNOON | MORNING_OFF
  unit        String?
  createdById String // chủ trì
  createdAt   DateTime @default(now())

  createdBy User        @relation("HcGroupCreator", fields: [createdById], references: [id])
  members   HcCheckIn[]

  @@index([date])
  @@index([createdById])
}

model HcCheckIn {
  id                 String    @id @default(cuid())
  groupId            String
  userId             String
  hours              Int       @default(8)
  isApproved         Boolean   @default(false)
  note               String?
  isRegistered       Boolean   @default(false)
  registrationStatus String    @default("PENDING") // PENDING | APPROVED | REJECTED | CANCELLED
  cancellationReason String?
  rejectionCount     Int       @default(0)
  handledById        String?
  handledByName      String?
  handledAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  group HcGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User    @relation("HcCheckInUser", fields: [userId], references: [id])

  @@unique([groupId, userId])
  @@index([userId])
  @@index([isApproved])
  @@index([registrationStatus])
}

// Tài liệu số (quy trình, sơ đồ P&ID, lưu trữ…). Bảng được tạo/đồng bộ bằng raw
// SQL trong app/api/documents/route.ts (ensureDigitalDocumentTable); khai báo ở
// đây để db push không đề nghị xoá. attachmentUrls lưu JSON (mảng data URL) dạng text.
model DigitalDocument {
  id               String    @id
  category         String
  title            String
  decisionNumber   String?
  issueDate        DateTime?
  documentUrl      String
  managingPosition String?
  managementBlock  String?
  procedureType    String?
  reason           String?
  // Tiến trình tách lưới / khởi động dạng văn bản tự do. KHÔNG bao giờ xoá kể cả
  // sau khi đã bóc tách — đây là bản gốc để đối chiếu khi parser hiểu sai.
  progress         String?
  // Bản đã bóc tách của `progress`: JSON các mốc thời gian có cấu trúc, do người
  // dùng soát và xác nhận một lần. Rỗng = chưa bóc tách, giao diện hiện văn bản thô.
  timelineJson     String?
  note             String?
  attachmentUrls   String?
  createdById      String?
  updatedById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now())

  @@index([category, updatedAt(sort: Desc)])
}

// Cấu hình ma trận phân quyền (RBAC) do ADMIN chỉnh trong /admin/roles. Bảng được
// tạo bằng raw SQL trong app/api/rbac/route.ts; value lưu JSON cấu hình dạng text.
model RbacConfig {
  key         String   @id
  value       String
  updatedById String?
  updatedAt   DateTime @default(now())
}

// Thông báo hệ thống (message box giữa màn hình do Quản trị phát). Bảng được
// tạo/đồng bộ bằng raw SQL trong app/api/broadcast/route.ts; khai báo ở đây để
// db push không đề nghị xoá.
model SystemBroadcast {
  id            String   @id
  title         String
  body          String
  isActive      Boolean  @default(true)
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())
}

// Bộ đếm ngày vận hành an toàn theo tổ máy (hiển thị trên dashboard). Bảng được
// tạo/đồng bộ bằng raw SQL trong app/api/safe-operation/route.ts; khai báo ở đây
// để db push / migrate diff không đề nghị xoá (tránh mất mốc ngày vận hành an toàn).
model SafeOperationSetting {
  id          String    @id
  unit        String    @unique
  startedAt   DateTime?
  pausedAt    DateTime?
  updatedAt   DateTime  @default(now())
  updatedById String?
}

// Cây danh mục thiết bị (nhập từ DM_ThietBi.xlsx). Phân cấp dựa trên "Số thứ tự"
// dạng chấm (vd "1.1.1" là cha của "1.1.1.1"). Tách riêng khỏi Device vận hành:
// khóa duy nhất là `seq` (mã thiết bị `code` có thể trùng giữa các node).
model EquipmentNode {
  id           String   @id @default(cuid())
  // seq = MÃ THIẾT BỊ đầy đủ (fullCode), vd "DH1.S1.5.1.1" — nguồn chuẩn ổn định để dựng
  // cây (materialized path) và là khóa nghiệp vụ (repair/defect/vật tư/QR tham chiếu qua đây).
  // KHÔNG dùng "Số thứ tự" (số vị trí, không ổn định khi đánh lại).
  seq          String   @unique
  externalId   String?  @unique // Assetid (ERP) — khóa ĐỐI SOÁT khi đồng bộ/nhập lại; ổn định tuyệt đối
  parentSeq    String? // Mã thiết bị của cha (tổ tiên gần nhất trong phạm vi); null nếu là gốc
  code         String // = seq (Mã thiết bị đầy đủ) — giữ bất biến code==seq mà nghiệp vụ đang dựa vào
  name         String // tên thiết bị
  kks          String? // mã KKS
  drawing      String? // bản vẽ liên quan
  depth        Int // số đoạn của seq (1..n)
  sort         Int // thứ tự ổn định theo file nguồn
  childCount   Int      @default(0) // số con trực tiếp (denormalize) — cây lazy biết hasChildren mà không cần query
  searchText   String   @default("") // name + kks + code đã bỏ dấu/lowercase — tìm kiếm không dấu phía server
  // Người dùng tự bổ sung khi sửa thẻ thiết bị (tách khỏi dữ liệu nhập từ Excel).
  attachedInfo String? // thông tin thêm
  documentUrl  String? // tài liệu đính kèm (link)
  imageUrl     String? // 1 hình ảnh (base64 hoặc URL)
  // true nếu node do đồng bộ khi TẠO MỚI thiết bị sinh ra (seq không có trong danh mục gốc).
  // Dùng để xóa node theo khi xóa Device, mà không đụng node danh mục nhập từ Excel.
  deviceSynced Boolean  @default(false)
  // true nếu nút đã được SẮP XẾP LẠI TAY trên web (đổi thư mục cha / đổi mã). Lệnh nhập danh
  // mục khớp theo Assetid và ghi đè seq/parentSeq theo file Excel, nên không có cờ này thì lần
  // nhập kế tiếp lặng lẽ kéo nút về đúng chỗ cũ trong file — công sắp xếp mất trắng mà không
  // ai thấy. Có cờ thì lệnh nhập giữ nguyên vị trí, chỉ cập nhật tên/KKS/bản vẽ.
  relocated    Boolean  @default(false)
  createdAt    DateTime @default(now())

  repairLogs             RepairLog[]
  deviceMaterials        EquipmentMaterial[]
  materialReplacements   MaterialReplacement[]
  defects                Defect[]
  defectHistories        DefectHistory[]
  relatedDefects         DefectRelatedDevice[]        @relation("DefectRelatedEquipment")
  relatedDefectHistories DefectHistoryRelatedDevice[] @relation("DefectHistoryRelatedEquipment")
  ticketItems            MaterialTicketItem[]
  qrCards                DeviceQrCard[]
  profiles               EquipmentProfile[]

  @@index([parentSeq])
  @@index([parentSeq, sort])
  @@index([code])
  @@index([depth])
  @@index([kks])
  @@index([name])
}

// GHI ĐÈ theo TỔ MÁY trên cây thiết bị dùng chung. Bảng THƯA và mặc định RỖNG.
//
// Một nút KHÔNG cần dòng ở đây để "tồn tại" ở một tổ máy: phạm vi tổ máy suy ra từ số
// nhánh của seq (machinesOf() — nhánh 5,6 → COMMON; còn lại → S1+S2), mã S2
// (DH1.S1→DH1.S2) và KKS S2 (ký tự đầu 1→2) đều là DẪN XUẤT (lib/equipment-units.ts).
// Chỉ tạo dòng khi một tổ máy đặt tên/KKS/ảnh/tài liệu KHÁC với node gốc.
//
// Dữ liệu nghiệp vụ KHÔNG nằm ở đây: repair/defect/vật tư/QR phân tổ máy bằng cột
// machine/unit trên chính bảng nghiệp vụ (deviceSeq vẫn trỏ node → giữ lọc quyền theo nhánh).
model EquipmentProfile {
  id           String   @id @default(cuid())
  nodeSeq      String // EquipmentNode.seq
  machine      String // "S1" | "S2" | "COMMON"
  kks          String? // override KKS (mặc định dẫn xuất: S2 = ký tự đầu 1→2)
  name         String? // override tên nếu tổ máy đặt khác
  attachedInfo String?
  documentUrl  String?
  imageUrl     String?
  createdById  String? // id người tạo (không FK — đã có audit log)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  node EquipmentNode @relation(fields: [nodeSeq], references: [seq], onDelete: Cascade)

  @@unique([nodeSeq, machine])
  @@index([machine])
}

// Thiết bị được CHỌN tạo thẻ QR ở tab "Thẻ" (chỉ thiết bị quan trọng — không sinh
// thẻ cho toàn bộ ~6500 node lá). Xoá node thiết bị thì thẻ tự mất theo (cascade).
model DeviceQrCard {
  id          String   @id @default(cuid())
  deviceSeq   String // EquipmentNode.seq của thiết bị (node lá)
  machine     String   @default("COMMON") // Tổ máy sở hữu thẻ: S1 | S2 | COMMON — mỗi tổ máy 1 thẻ QR riêng trên cùng nút
  createdById String? // id người tạo (không FK — giữ nhẹ, đã có audit log)
  createdAt   DateTime @default(now())

  device EquipmentNode @relation(fields: [deviceSeq], references: [seq], onDelete: Cascade)

  @@unique([deviceSeq, machine])
}

// Phạm vi hệ thống thiết bị được gán cho từng cương vị quản lý.
// Dùng để lọc nhanh danh sách thiết bị khi tạo lịch sử sửa chữa, khiếm khuyết và vật tư.
model PositionSystemScope {
  id           String   @id @default(cuid())
  position     String
  positionCode String? // mã cương vị ổn định để bí danh khác nhau dùng chung một phạm vi
  systemSeq    String
  access       String   @default("view") // Mức quyền của cương vị với hệ thống: "view" | "edit"
  createdAt    DateTime @default(now())

  @@unique([position, systemSeq])
  @@index([position])
  @@index([positionCode])
  @@index([systemSeq])
}

// Ghi đè công trực ca theo từng dòng trong ngày (do người có quyền duyệt/chỉnh công đặt).
// Khóa chính gồm (userId, date, line). CRUD chạy bằng raw SQL trong app/api/shifts/timesheet/route.ts;
// khai báo ở đây để db push tạo bảng và không đề nghị xoá.
model TimesheetOverride {
  userId      String
  date        String // YYYY-MM-DD
  line        String   @default("shift1") // shift1 | shift2 | hc
  value       String
  note        String?
  updatedById String?
  updatedAt   DateTime @default(now())

  @@id([userId, date, line])
}

// Dữ liệu vòi dầu buồng đốt: 36 vòi/tổ máy (S1, S2), trạng thái khả dụng + khiếm khuyết.
model OilGun {
  id             String    @id @default(cuid())
  machine        String // "S1" | "S2"
  code           String // "D1", "E1", "A3"...
  wall           String // "REAR" (tường sau) | "FRONT" (tường trước)
  position       Int       @default(0) // thứ tự hiển thị trên sơ đồ
  status         String    @default("available") // available | unavailable
  defect         String? // (legacy) khiếm khuyết cũ 1 ô — đã tách thành defectSccn/defectScd, giữ để không mất dữ liệu
  defectSccn     String? // Khiếm khuyết SCCN (sửa chữa cơ nhiệt)
  defectScd      String? // Khiếm khuyết SCĐ (sửa chữa điện)
  forceFlame     Boolean   @default(false) // Force tín hiệu ngọn lửa vòi dầu
  // Lớp vòi than — chung vị trí với vòi dầu (Hướng A: cột song song)
  coalStatus     String    @default("available") // available | unavailable
  coalDefectNote String? // khiếm khuyết vòi than (1 ô, vì than ít)
  coalUpdatedBy  String?
  coalUpdatedAt  DateTime?
  updatedBy      String? // tên người cập nhật gần nhất
  updatedAt      DateTime  @updatedAt
  createdAt      DateTime  @default(now())

  @@unique([machine, code])
  @@index([machine])
}

// Ghi chú chung cho sơ đồ vòi dầu theo từng tổ máy (S1/S2) — 1 dòng/tổ máy.
model OilGunNote {
  machine   String   @id // "S1" | "S2"
  note      String   @default("")
  updatedBy String?
  updatedAt DateTime @default(now()) @updatedAt
}

// BGTS Tuabin ngừng: bảng ghi thông số DCS theo ngày, dùng trong Thư mục lưu trữ
// > Dữ liệu tách lưới > BGTS Tuabin Ngừng. API tạo/đồng bộ bảng bằng raw SQL để
// bổ sung an toàn trên DB dev hiện có; khai báo ở đây để db push không đề nghị xoá.
model BgtsTurbineShutdownRecord {
  id                     String    @id
  unit                   String
  date                   String // YYYY-MM-DD
  dayShiftSigner         String?
  middleShiftSigner      String?
  nightShiftSigner       String?
  // Mốc xác nhận từng ca — tạo/đồng bộ bằng raw SQL trong app/api/bgts-tuabin-ngung/route.ts;
  // khai báo ở đây để migrate diff / db push không đề nghị xoá (giữ dữ liệu xác nhận).
  dayShiftConfirmedAt    DateTime?
  middleShiftConfirmedAt DateTime?
  nightShiftConfirmedAt  DateTime?
  createdById            String?
  updatedById            String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @default(now())

  rows BgtsTurbineShutdownRow[]

  @@unique([unit, date])
  @@index([date])
}

model BgtsTurbineShutdownRow {
  id                                     String @id
  recordId                               String
  timeHour                               Int
  turbineLubeOilPressure                 Float?
  shaftJackingOilPressure                Float?
  rotateSpeed                            Float?
  turningGearElectricity                 Float?
  eccentricity                           Float?
  hpMpCasingExpansionLeft                Float?
  hpMpCasingExpansionRight               Float?
  axialDisplacement                      Float?
  hpMpCasingDifferentialExpansion        Float?
  lpCasingDifferentialExpansion          Float?
  hpMainSteamValveWallTempInside         Float?
  hpMainSteamValveWallTempOutside        Float?
  hpRegulatingValveWallTempInside        Float?
  hpRegulatingValveWallTempOutside       Float?
  hpInnerCasingLowerPartTempInside       Float?
  hpInnerCasingLowerPartTempOutside      Float?
  hpExhaustOuterCasingInnerWallTempTop   Float?
  hpExhaustOuterCasingInnerWallTempLower Float?
  hpExhaustPipeTempLeft1                 Float?
  hpExhaustPipeTempLeft2                 Float?
  hpExhaustPipeTempRight1                Float?
  hpExhaustPipeTempRight2                Float?
  mpIntakeMetalTempInnerWall             Float?
  mpIntakeMetalTempOuterWall             Float?
  mpExhaustInnerWallTempTop              Float?
  mpExhaustInnerWallTempLower            Float?

  record BgtsTurbineShutdownRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@unique([recordId, timeHour])
  @@index([recordId])
}

// Phiếu thay thế vật tư (2 luồng: Đề xuất chuẩn & Ứng xử lý gấp).
// LÔ TỒN KHO THEO SỐ PHIẾU GIAO HÀNG.
//
// Trước đây "Hiện có" chỉ là MỘT CON SỐ trên Material: lãnh về thì cộng, dùng thì trừ, nên
// không biết phần còn lại thuộc phiếu giao hàng nào — trong khi biên bản nghiệm thu phải dẫn
// đúng số phiếu của lô đã dùng. Mỗi lần lãnh về nay là một lô; dùng thì trừ LÔ CŨ TRƯỚC
// (FIFO) để dọn hết tồn của phiếu cũ rồi mới ăn sang phiếu mới.
//
// KHOÁ LÔ LÀ `materialCode + stockUnit`, không phải id. Vật tư thường dùng stockUnit=COMMON
// để giữ kho chung như trước; riêng Chai khí tách S1/S2/COMMON vì chai lãnh tổ nào chỉ được
// cộng/trừ tại tổ đó.
//
// `Material.quantity` GIỮ LẠI làm tổng các lô còn lại (tính lại sau mỗi lần ghi), để mọi màn hình
// và báo cáo đang đọc cột đó không phải sửa.
model MaterialStockLot {
  id                  String    @id @default(cuid())
  materialCode        String // = Material.code
  stockUnit           String    @default("COMMON") // Chai khí tách kho S1 | S2 | COMMON; vật tư khác dùng COMMON
  deliveryNote        String? // số phiếu giao hàng; null = tồn đầu kỳ chưa rõ phiếu
  erpCode             String? // mã vật tư ERP đã lãnh, in kèm trên biên bản
  // null = tồn đầu kỳ: xếp ĐẦU hàng đợi FIFO để dùng hết trước các lô có phiếu.
  receivedAt          DateTime?
  quantityIn          Int // số lãnh về ban đầu
  quantityLeft        Int // còn lại sau khi trừ các lần sử dụng
  ticketId            String? // phiếu đã lãnh lô này về; mỗi phiếu một lô
  note                String?
  // Ảnh phiếu xuất kho LIÊN 3, bắt buộc kèm theo Biên bản vật tư thu hồi (chú thích số 6
  // của mẫu QLVT.06: "Nộp kèm bản photo Phiếu Giao hàng").
  //
  // Ảnh thuộc về LÔ chứ không thuộc về phiếu, vì một lô lãnh về có thể được nhiều phiếu
  // dùng dần: phần chưa dùng hết thành tồn, phiếu sau lấy tiếp từ đúng lô đó và vẫn phải
  // xuất kèm đúng tờ liên 3 ấy. Gắn vào phiếu thì phiếu sau không còn gì để in.
  //
  // Xoá khi lô dùng hết VÀ mọi phiếu đã dùng lô đều quyết toán xong — xem
  // `purgeSettledLotPhotos`.
  deliveryPhotoKey    String? // khóa S3
  deliveryPhotoAt     DateTime?
  deliveryPhotoByName String? // người đính kèm, đóng băng tại thời điểm chụp
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  usages MaterialLotUsage[]

  @@index([materialCode, stockUnit, quantityLeft])
  @@index([ticketId])
}

model MaterialLotUsage {
  id        String   @id @default(cuid())
  lotId     String
  ticketId  String
  quantity  Int
  createdAt DateTime @default(now())

  lot MaterialStockLot @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([lotId])
}

// Sổ nhập/cấp/sử dụng của kho Vật tư khác tại phân xưởng. Tồn thực tế vẫn nằm ở
// MaterialStockLot; bảng này là chứng từ nghiệp vụ, còn phân bổ FIFO dùng
// MaterialLotUsage với ticketId = "movement:<id>".
model MaterialStockMovement {
  id                String   @id @default(cuid())
  materialId        String
  materialCode      String
  erpCodes          String[] @default([]) // mã ERP thực tế của lô nhập/các lô FIFO đã xuất
  type              String // RECEIPT | ISSUE | USE | ADJUST
  quantity          Int
  stockBefore       Int
  stockAfter        Int
  occurredAt        DateTime
  ticketId          String?
  ticketItemId      String?
  assignedPosition  String?
  unit              String?
  deviceSeq         String?
  receiverId        String?
  receiverName      String?
  issuerId          String?
  issuerName        String?
  note              String?
  createdById       String
  createdByName     String
  createdByPosition String?
  createdAt         DateTime @default(now())

  material Material @relation(fields: [materialId], references: [id])

  @@index([materialCode, occurredAt(sort: Desc)])
  @@index([materialId, occurredAt(sort: Desc)])
  @@index([ticketId])
  @@index([type, occurredAt(sort: Desc)])
}

model MaterialTicket {
  id             String @id @default(cuid())
  sequenceMonth  String // YYYY-MM theo giờ Việt Nam; mỗi tháng có dãy STT riêng
  sequenceNumber Int // STT cố định trong tháng, tăng liên tục theo thứ tự tạo phiếu
  // Dãy STT: MATERIAL (vật tư thường) | CHEMICAL (hóa chất + NH3 khai một bước).
  // Suy từ `type` ngay lúc tạo và KHÔNG đổi về sau — xem sequenceScopeOfType().
  sequenceScope  String @default("MATERIAL")
  type           String // "DE_XUAT" | "UNG"
  unit           String // Tổ máy: S1 | S2 | COMMON
  status         String // máy trạng thái theo type

  assignedPosition String // cương vị được giao — CHỈ cương vị này thao tác đề xuất/nhập liệu và thấy phiếu (trừ nhóm quản lý)
  materialCategory String? // Loại vật tư: "Dầu bôi trơn" | "Lọc dầu" | "Hóa chất" | "Bi nghiền"

  bbktNumber           String? // số Biên Bản Kiểm Tra (Đề xuất: nhập ở bước nghiệm thu, nếu có; Ứng: bổ sung sau PDF)
  proposalNote         String? // ghi chú khi tạo phiếu đề xuất (thay cho BBKT ở B0)
  // SYC sửa chữa đã ra TỪ phiếu này (giai đoạn 2 — cổng vật tư đứng trước SYC).
  // `repairRequestNumber` phía dưới vẫn giữ nguyên làm SNAPSHOT số hiệu: phiếu khiếm khuyết
  // có thể bị xoá, số đã in trên chứng từ thì không được biến mất theo.
  defectId             String?
  pctNumber            String? // số PCT/LCT (nhập ở bước nghiệm thu/xuất file)
  proposalNumber       String? // số phiếu đề xuất vật tư (Thống kê nhập)
  proposalDocUrl       String? // file Word Phiếu ĐXVT (QLVT.12) trên MinIO — xuất trước khi nhập số phiếu
  proposalIssuedAt     DateTime? // Thống kê xác nhận giao phiếu ĐXVT (giữ tên cột cũ để tương thích dữ liệu)
  proposalReceiverName String? // tên VHV nhận phiếu ĐXVT khi Thống kê giao phiếu
  deliveryNoteNumber   String? // số phiếu giao hàng
  repairRequestNumber  String? // số yêu cầu sửa chữa
  pctContent           String? // nội dung công việc ghi trên PCT/LCT
  completionNote       String? // thông tin xác nhận thay thế xong
  chiHuyName           String? // tên chỉ huy trực tiếp (SCCN) — in vào BBNT
  docUrl               String? // file Word BBNT trên MinIO
  bbktDocUrl           String? // file Word BBKT, tách riêng khỏi BBNT DO
  // Các chuyến xe hóa chất đã ghi cho phiếu này (ChemicalReceipt.id).
  // Luồng hóa chất không đi qua kho DH1 nên phiếu KHÔNG cộng tồn và KHÔNG trừ ERP
  // (xem commit 83aa5b5); ba trường ngày nhập / biển số / khối lượng của từng chuyến
  // xe chỉ tồn tại trong ChemicalReceipt — ở đây chỉ giữ con trỏ, không giữ bản sao.
  chemicalReceiptIds   String[]  @default([])

  recoveryRequired           Boolean? // có vật tư thu hồi hay không
  recoveryQuantity           Int?
  recoveryReturnedAt         DateTime?
  recoveryDocUrl             String? // biên bản vật tư thu hồi (bổ sung khi có mẫu)
  recoveryDocNo              Int? // số văn bản BBTHVT đã cấp — giữ nguyên khi xuất lại biên bản
  recoveryDocNoYear          Int? // năm cấp số văn bản (dãy số reset mỗi năm)
  workStartedAt              DateTime? // thời gian ghi vào BBNT DO
  workEndedAt                DateTime?
  sccnRepresentativeName     String? // đại diện đơn vị sửa chữa cơ nhiệt in trên BBNT D-Office
  sccnRepresentativePosition String? // chức vụ đại diện SCCN tại thời điểm xuất biên bản
  bbntDoNumber               String? // số BBNT D-Office nhập tại bước quyết toán
  settledAt                  DateTime? // Thống kê xác nhận đã quyết toán
  settledByName              String?
  rejectedReason             String?

  // dấu vết từng bước: id + tên hiển thị (đóng băng tại thời điểm thao tác)
  createdById           String
  createdByName         String
  proposedById          String?
  proposedByName        String?
  proposedByPosition    String?
  proposedAt            DateTime?
  confirmedById         String?
  confirmedByName       String?
  confirmedByPosition   String? // cương vị người xác nhận (hiện trong lịch sử phiếu)
  confirmedAt           DateTime? // mốc tính quy tắc 2 ngày (luồng đề xuất)
  statsById             String?
  statsByName           String?
  statsByPosition       String? // cương vị người nhập số phiếu ĐXVT
  statsAt               DateTime?
  // LUỒNG HÓA CHẤT: bước Thống kê / Kỹ thuật viên xác nhận đề xuất chốt lịch và khối lượng giao.
  // Hóa chất mua theo lô, giao bằng xe bồn theo hợp đồng nên phải hẹn ngày giao, khác hẳn
  // vật tư kỹ thuật lãnh thẳng tại kho.
  deliveryScheduledAt   DateTime? // lịch giao hàng
  deliveryQuantity      Int? // khối lượng giao theo lịch
  // Bước VHV LÃNH VẬT TƯ của luồng Ứng (không tác động ERP)
  vhvReceivedQuantity   Int?
  vhvMaterialCode       String?
  vhvReceivedByName     String?
  vhvReceivedByPosition String?
  vhvReceivedAt         DateTime?
  // Bước NHẬN VẬT TƯ (NHAN_VAT_TU)
  receivedQuantity      Int? // khối lượng vật tư lãnh
  receivedMethod        String? // hình thức lãnh nhập tự do
  receiptSource         String? // ERP | EXISTING — nguồn lãnh vật tư (OUTSIDE là giá trị cũ)
  receivedById          String?
  receivedByName        String?
  receivedByPosition    String?
  receivedAt            DateTime?
  // Bước SỬ DỤNG VẬT TƯ (SU_DUNG_VAT_TU)
  usedQuantity          Int? // khối lượng vật tư sử dụng
  remainingQuantity     Int? // còn lại = lãnh − dùng (âm = dùng vượt phần lãnh, trừ vào tồn kho)
  materialUserName      String? // tên VHV trực tiếp sử dụng vật tư
  // Ba ảnh hiện trường chèn vào BBNT D-Office, lưu KHÓA S3 chứ không phải base64
  // (ảnh chụp máy là vài MB, nhét vào cột text sẽ phình bảng phiếu).
  // TẠM THỜI: xóa hẳn khỏi S3 khi Thống kê xác nhận quyết toán — xem action "settle".
  usagePhotoBeforeKey   String? // Hình 1 — thiết bị TRƯỚC khi thay thế/bổ sung
  usagePhotoAfterKey    String? // Hình 2 — thiết bị SAU khi thay thế/bổ sung
  usagePhotoSpecKey     String? // Hình 3 — thông số thiết bị hoặc vật tư thay thế
  usedById              String?
  usedByName            String?
  usedByPosition        String?
  usedAt                DateTime?
  completedById         String?
  completedByName       String? // Trưởng Ca/TK xuất file — in vào Hội đồng nghiệm thu
  completedByPosition   String? // cương vị người nghiệm thu
  completedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items            MaterialTicketItem[]
  defect           Defect?                     @relation("MaterialTicketDefect", fields: [defectId], references: [id], onDelete: SetNull)
  replacementLinks MaterialTicketReplacement[]

  @@unique([sequenceMonth, sequenceScope, sequenceNumber])
  @@index([sequenceMonth, sequenceScope])
  @@index([status])
  @@index([unit, status])
  @@index([type])
  @@index([assignedPosition])
  @@index([defectId])
}

/// Phiếu vật tư phục vụ điểm thay thế nào.
///
/// Thay cho `MaterialTicketItem.replacementPointKeys` — mảng đó chỉ chứa CHUỖI `deviceSeq`
/// (xem `replacementPointSelectionKey`), nên biết phiếu phục vụ thiết bị nào nhưng không biết
/// phục vụ KỲ THAY THẾ nào. Không có khoá ngoại thật thì không thể ghi lịch sử thay thế bằng
/// khối lượng thực dùng, cũng không mồi sẵn được thiết bị/cương vị khi ra SYC từ phiếu.
///
/// Mảng cũ VẪN GIỮ, không xoá: `lib/equipment-move.ts` còn dựa vào nó khi đổi mã thiết bị, và
/// nó là snapshot đọc được cả khi điểm đã bị xoá khỏi danh mục.
model MaterialTicketReplacement {
  id              String   @id @default(cuid())
  ticketId        String
  // Xoá điểm khỏi danh mục thì gỡ luôn liên kết; lịch sử thay thế không bị ảnh hưởng vì
  // MaterialReplacementLog neo mềm và mang đủ snapshot.
  replacementId   String
  /// Nhu cầu của điểm tại lúc gắn = `quantity × deviceCount`. Snapshot, cố ý không đọc lại
  /// qua quan hệ: sửa khai báo điểm sau đó không được làm đổi con số phiếu đã căn cứ.
  plannedQuantity Int?
  createdAt       DateTime @default(now())

  ticket      MaterialTicket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  replacement MaterialReplacement @relation(fields: [replacementId], references: [id], onDelete: Cascade)

  @@unique([ticketId, replacementId])
  @@index([replacementId])
}

// Phân quyền các bước của quy trình phiếu thay thế vật tư: admin gán CƯƠNG VỊ nào
// được thao tác ở bước nào ("create" tạo phiếu/đề xuất, "confirm" xác nhận,
// "accept" nghiệm thu, "manage" sửa/xoá phiếu). Bước chưa cấu hình → dùng mặc
// định cũ (Trưởng Ca/KTV/…) để không gãy khi mới deploy.
model MaterialWorkflowRole {
  id        String   @id @default(cuid())
  step      String // mã bước trong WORKFLOW_STEPS (lib/material-workflow.ts)
  position  String // cương vị được phép thao tác bước này
  createdAt DateTime @default(now())

  @@unique([step, position])
  @@index([step])
}

// Cấp số văn bản Biên bản vật tư thu hồi (BBTHVT): tăng dần 1, 2, 3… và reset về 1
// khi sang năm mới. Mỗi năm một dòng; tăng số bằng upsert increment (atomic).
model RecoveryDocSequence {
  year  Int @id
  value Int @default(0)
}

model MaterialTicketItem {
  id                   String   @id @default(cuid())
  ticketId             String
  materialId           String
  erpCode              String?
  erpName              String? // tên vật tư ERP đóng băng khi chọn mã, dùng cho biên bản
  deviceSeq            String? // thiết bị theo EquipmentNode.seq; phiếu đề xuất mới có thể nhập tay tên thiết bị
  replacementPointKeys String[] @default([]) // các điểm/thiết bị được chọn; giữ deviceSeq đầu tiên để tương thích dữ liệu cũ
  deviceNameManual     String?
  quantity             Int      @default(1)
  replacementQuantity  Int? // số lượng thay thế do cương vị phân giao nhập ở luồng Ứng
  receivedQuantity     Int? // số lượng thực lãnh của riêng dòng (phiếu Vật tư khác nhiều dòng)

  ticket   MaterialTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  material Material       @relation(fields: [materialId], references: [id])
  device   EquipmentNode? @relation(fields: [deviceSeq], references: [seq], onDelete: SetNull)

  @@index([ticketId])
  @@index([deviceSeq])
}

// Tombstone phục vụ đồng bộ một chiều: phiếu đã xóa cứng không còn trong
// MaterialTicket, nhưng n8n vẫn cần biết chính xác SYNC_KEY nào phải xóa khỏi Sheet.
model MaterialTicketSyncDeletion {
  id        String   @id @default(cuid())
  ticketId  String
  syncKey   String   @unique
  deletedAt DateTime @default(now())

  @@index([deletedAt, id])
  @@index([ticketId])
}

// Lưu các mốc thời gian cho phần Vận hành an toàn (Safe Operation).
// Các CHECK constraint và partial unique index cho "continuous" được áp bằng
// prisma/add_safe_op_events.sql vì Prisma chưa biểu diễn được partial index.
model SafeOperationEvent {
  id        String    @id @default(cuid())
  unit      String // "S1" hoặc "S2"
  category  String // "continuous", "standby", "maintenance", "incident"
  startedAt DateTime
  endedAt   DateTime?
  reason    String?
  isAdded   Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([unit, category])
  @@index([createdAt])
}

// ---------------------------------------------------------------------
// GOM NHÓM VẬT TƯ DẦU — Phương án 3 (Hybrid: tự động gợi ý + người duyệt)
// Gom các mã vật tư ERP cùng loại dầu → tổng tồn kho theo loại + cảnh báo
// dưới ngưỡng. Mapping đã duyệt lưu vĩnh viễn (cơ chế "học dần").
// ---------------------------------------------------------------------

enum MappingStatus {
  UNMAPPED // mã mới, chưa chạy matching hoặc không tìm được gợi ý
  SUGGESTED // đã có gợi ý, chờ người duyệt
  CONFIRMED // đã gom nhóm (mapping vĩnh viễn)
  IGNORED // không phải dầu / không cần gom (không hỏi lại)
}

model OilType {
  id        String  @id @default(cuid())
  code      String  @unique // "T32", "VG46", "15W40", "LOC-TB"...
  name      String // "Dầu tuabin T32", "Lõi lọc dầu tuabin"...
  baseUnit  String // đơn vị chuẩn để cộng tồn: "Lít", "Cái", "Kg", "Viên"
  minStock  Float? // ngưỡng cảnh báo đề xuất nhập (theo baseUnit)
  onHandQty Float   @default(0) // "Hiện có" — số đếm thực tế tại kho, nhập tay trên UI
  note      String?
  // Loại vật tư của nhóm — khớp Material.category / ErpMaterial.category:
  // "Dầu bôi trơn" | "Lõi lọc dầu" | "Hóa Chất" | "Bi Nghiền Than"
  category  String  @default("Dầu bôi trơn")

  materials ErpMaterial[]
  logs      OilTypeMappingLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@map("oil_types")
}

// Audit trail: ai gom mã nào vào nhóm nào, lúc nào, vì sao.
// Phục vụ truy vết theo CS-ATTT-KTAT-21 / ISO 27001.
model OilTypeMappingLog {
  id         String      @id @default(cuid())
  materialId String
  material   ErpMaterial @relation(fields: [materialId], references: [id])
  oilTypeId  String?
  oilType    OilType?    @relation(fields: [oilTypeId], references: [id])

  action String // SUGGESTED | CONFIRMED | CHANGED | REMOVED | IGNORED
  score  Float?
  reason String?
  userId String? // id user NextAuth thực hiện thao tác (null = hệ thống)

  createdAt DateTime @default(now())

  @@index([materialId])
  @@map("oil_type_mapping_logs")
}

// Kết quả phân tích dầu KHÔNG ĐẠT, đọc một chiều từ LIMS
// (portal.tpcduyenhai.com.vn/lims.xhtml) qua tiện ích Chrome.
// Chỉ lưu đúng các trường hiển thị ở bảng danh sách LIMS — không lấy chi tiết
// chỉ tiêu. App chỉ ĐỌC: mọi thay đổi nghiệp vụ vẫn thực hiện trên LIMS.
model OilAnalysisFailure {
  id     String @id @default(cuid())
  limsId String @unique // data-rk (GUID) của dòng trên LIMS — khoá đối chiếu

  soPhieu    String // cột "Số", vd 23/07/26-04
  khuVuc     String // Duyên Hải 1 / 3 / 3 Mở Rộng
  donVi      String // cột "Đơn vị", vd PX Vận hành 1
  tenMau     String // cột "Tên mẫu dầu"
  ngayLayMau DateTime?
  danhGia    String?
  ykienPkt   String? // Ý kiến PKT
  ykienQlvh  String? // Ý kiến QLVH — do PX Vận hành điền TRÊN LIMS, ở đây chỉ hiển thị
  ngayTraKq  DateTime?

  firstSeenAt DateTime @default(now()) // lần đầu đồng bộ về — dùng để đánh dấu "mới"
  syncedAt    DateTime @default(now()) // lần đồng bộ gần nhất chạm vào bản ghi
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([khuVuc, donVi])
  @@index([ngayTraKq])
  @@map("oil_analysis_failures")
}

// ============================================================================
// QUẢN LÝ THIẾT BỊ PCCC (Phân xưởng Vận hành 1)
//
// Thay thế file Excel "Quản lý BCC và TCC.xlsx" + bản web demo tĩnh (localStorage):
// Postgres là NGUỒN SỰ THẬT DUY NHẤT. Ba nhóm thiết bị + 1 bảng thông số FM200,
// tất cả đều gắn với MỘT KỲ KIỂM TRA (PcccPeriod) = 1 tháng, đúng như Excel gốc
// tách sheet theo tháng ("BÌNH CHỮA CHÁY - T08.2026").
//
// Quy ước dùng chung cho các module theo kỳ sau này (chi tiêu QDU, hoá chất
// NH3/HCl/NaOH): 1 bảng "kỳ" + n bảng "chỉ số trong kỳ" + 1 bảng chữ ký chung.
// ============================================================================

// Một kỳ kiểm tra = 1 tháng. Sang tháng mới, bản ghi được COPY từ kỳ trước rồi
// xoá ngày/người kiểm tra + chữ ký (logic createNextMonthFrom của bản demo).
model PcccPeriod {
  id       String  @id @default(cuid())
  label    String  @unique // "T08.2026" — đúng hậu tố tên sheet Excel
  year     Int
  monthNo  Int // 1..12
  isClosed Boolean @default(false) // đã chốt: chỉ đọc, không cho sửa/ký thêm

  closedAt     DateTime?
  closedById   String? // id User (không FK — đã có audit log); null = hệ thống tự chốt
  // Bản Excel đã đẩy lên S3 lúc chốt kỳ. DB chỉ giữ 6 kỳ gần nhất nên FILE TRÊN S3 mới
  // là bản lưu trữ dài hạn — vì vậy không được chốt kỳ khi chưa upload xong (xem
  // lib/pccc-rollover.ts).
  archiveKey   String? // vd "pccc/archive/2026/PCCC-T08.2026.xlsx"
  archivedAt   DateTime?
  archiveBytes Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  extinguishers       PcccExtinguisher[]
  cabinets            PcccCabinet[]
  bulks               PcccBulk[]
  fm200Panels         PcccFm200Panel[]
  alarmButtons        PcccAlarmButton[]
  valves              PcccValve[]
  emergencyLights     PcccEmergencyLight[]
  hoseReels           PcccHoseReel[]
  fireControlCabinets PcccFireControlCabinet[]
  signatures          PcccSignature[]

  @@unique([year, monthNo])
  @@index([isClosed])
  @@map("pccc_periods")
}

// BÌNH CHỮA CHÁY (BCC) — 20 cột hiển thị của sheet "BÌNH CHỮA CHÁY - <kỳ>".
// Thứ tự field ở đây GIỮ ĐÚNG thứ tự cột gốc trong Excel (cột 1..20) để việc
// xuất Excel bám theo nguồn; UI hiển thị theo thứ tự khác (BCC_DISPLAY_ORDER).
model PcccExtinguisher {
  id       String     @id @default(cuid())
  periodId String
  period   PcccPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  stt                 Float? // cột 1  — "STT" (Excel ghi 1.0, 2.0…)
  ma                  String // cột 2  — "Mã thiết bị", vd VH1/BCC/TBTH/01/22
  chungLoai           String? // cột 3  — Bình MFZ (bột) | Bình CO2 | Bình Foam
  viTri               String? // cột 4  — Vị trí lắp đặt
  // Cương vị quản lý — CHUẨN HOÁ theo POSITION_CATALOG: nhãn KHÔNG mang hậu tố tổ
  // máy ("Lò phó"), tổ máy tách sang cột `machine`. `cuongViCode` là PositionCode —
  // khóa dùng cho phân quyền; đổi cách viết nhãn không làm sai quyền. lib/pccc-position.ts
  cuongVi             String? // cột 5  — nhãn hiển thị đã chuẩn hoá
  cuongViCode         String? // PositionCode, vd BOILER_DEPUTY
  machine             String    @default("COMMON") // S1 | S2 | COMMON (suy từ hậu tố cương vị)
  // Cấp giám sát (KHÔNG phải tên người): TK Lò máy / Trưởng kíp điện / Trưởng ca
  nguoiGiamSat        String? // cột 6  — nhãn hiển thị đã chuẩn hoá
  nguoiGiamSatCode    String? // PositionCode của cấp giám sát
  sl                  Float? // cột 7
  dvt                 String? // cột 8
  tinhTrang           String? // cột 9  — Khả dụng | Cần theo dõi | Bất khả dụng
  // cột 10 — Áp suất bình MFZ / KL bình CO2, tính bằng PHẦN TRĂM (0–100).
  // Trước là chuỗi chọn sẵn ("Đủ áp", "Hết áp", "Đúng theo khối lượng"…); mẫu mới cho
  // đọc thẳng số trên đồng hồ/cân nên hai chủng loại dùng chung một ô số.
  apSuat              Float?
  viTriHienTai        String? // cột 11
  tinhTrangNgoai      String? // cột 12 — Gỉ sét thân bình / tay nắm…
  nguonGoc            String? // cột 13 — Nguồn gốc / NSX
  thoiGianThayGanNhat DateTime? // cột 14
  ngaySx              DateTime? // cột 15
  thoiGianSd          Float? // cột 16 — số NĂM sử dụng
  denHanThayThe       DateTime? // cột 17 — DẪN XUẤT = ngaySx + thoiGianSd, lưu sẵn để lọc/đếm "quá hạn"
  ngayKiemTra         DateTime? // cột 18
  nguoiKiemTra        String? // cột 19
  ghiChu              String? // cột 20

  // Tham chiếu MỀM tới cây thiết bị (EquipmentNode.seq) — KHÔNG đặt FK: mã PCCC
  // (VH1/BCC/…) hiện chưa có trong danh mục cây, phần lớn dòng còn null; đặt FK
  // sẽ chặn import. Khi nào map xong thì siết lại bằng migration riêng.
  deviceSeq String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([periodId, ma])
  @@index([periodId, cuongViCode])
  @@index([periodId, machine])
  @@index([periodId, tinhTrang])
  @@index([periodId, chungLoai])
  @@index([deviceSeq])
  @@map("pccc_extinguishers")
}

// TỦ CHỮA CHÁY (TCC) — 7 cột định danh + 10 nhóm linh kiện (mỗi nhóm 2..4 trạng
// thái, xem PcccCabinetComponent) + 4 cột cuối.
model PcccCabinet {
  id       String     @id @default(cuid())
  periodId String
  period   PcccPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  stt         Float? // cột 1
  ma          String // cột 2 — "Mã thiết bị"
  ten         String? // cột 3 — Tên / Loại tủ (chứa INDOOR/OUTDOOR)
  viTri       String? // cột 4
  cuongVi     String? // cột 5 — nhãn chuẩn hoá, xem ghi chú ở PcccExtinguisher.cuongVi
  cuongViCode String?
  machine     String  @default("COMMON") // S1 | S2 | COMMON
  sl          Float? // cột 6
  dvt         String? // cột 7

  soYcsc       String? // cột kề sau khối linh kiện — "Số YCSC"
  ngayKiemTra  DateTime?
  nguoiKiemTra String?
  ghiChu       String?

  // DẪN XUẤT từ các linh kiện (nhóm cuối = nặng → "Bất khả dụng"; nhóm giữa →
  // "Cần theo dõi"). Lưu sẵn để dashboard/lọc không phải quét bảng con.
  tinhTrangTongThe String?

  deviceSeq String? // xem ghi chú ở PcccExtinguisher.deviceSeq

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  components PcccCabinetComponent[]
  // Cuộn vòi chữa cháy là danh mục CON của tủ — xoá tủ thì cuộn vòi đi theo.
  hoseReels  PcccHoseReel[]

  @@unique([periodId, ma])
  @@index([periodId, cuongViCode])
  @@index([periodId, machine])
  @@index([periodId, tinhTrangTongThe])
  @@index([deviceSeq])
  @@map("pccc_cabinets")
}

// Một ô tích ☑/☐ của bảng TCC: (nhóm linh kiện × trạng thái).
// CHO PHÉP nhiều trạng thái cùng được tích trong 1 nhóm — quy tắc có chủ đích
// của vòng làm việc trước, đừng "sửa" thành single-select.
// groupOrder/statusOrder giữ đúng thứ tự cột gốc Excel để dựng lại header 2 tầng
// và file xuất Excel.
model PcccCabinetComponent {
  id        String      @id @default(cuid())
  cabinetId String
  cabinet   PcccCabinet @relation(fields: [cabinetId], references: [id], onDelete: Cascade)

  groupLabel  String // "KÍNH" | "THÂN TỦ" | "LĂNG PHUN" | …
  status      String // "Khả dụng" | "Thiếu ron" | "Gỉ sét" | "Bất khả dụng" | …
  checked     Boolean @default(false)
  groupOrder  Int
  statusOrder Int

  @@unique([cabinetId, groupLabel, status])
  @@index([cabinetId])
  @@map("pccc_cabinet_components")
}

// FOAM / CO2 / DIESEL — bồn & mức, theo % khối lượng còn lại.
// Không có "Mã thiết bị" trong Excel → khoá nghiệp vụ là (kỳ, tên).
model PcccBulk {
  id       String     @id @default(cuid())
  periodId String
  period   PcccPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  stt              Float?
  ten              String // "Bồn Foam" | "Bồn CO2" | "Mức dầu DO bơm chữa cháy Diesel"
  cuongVi          String? // nhãn chuẩn hoá, xem ghi chú ở PcccExtinguisher.cuongVi
  cuongViCode      String?
  machine          String    @default("COMMON") // S1 | S2 | COMMON
  viTri            String?
  dvt              String?
  khoiLuongThietKe Float?
  khoiLuongHienTai Float?
  phanTramConLai   Float? // DẪN XUẤT = hienTai / thietKe
  tinhTrang        String? // DẪN XUẤT theo ngưỡng — xem ghi chú ngưỡng ở docs/pccc.md
  ngayChot         DateTime?
  nguoiChot        String?
  ghiChu           String?

  deviceSeq String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([periodId, ten])
  @@index([periodId, cuongViCode])
  @@index([periodId, machine])
  @@map("pccc_bulks")
}

// FM200 — bố cục NGANG: mỗi bình là 1 CỘT, 2 dòng chỉ số (Mức FM200, Áp suất N2).
// 1 bản ghi = 1 bảng/kỳ (phòng kích từ hoặc nhà ĐKTT), KÝ 1 LẦN CHO CẢ BẢNG —
// không ký theo từng bình (đổi thiết kế ở vòng làm việc trước).
// Trạng thái/% là DẪN XUẤT từ (giá trị − min)/(max − min) → không lưu.
model PcccFm200Panel {
  id       String     @id @default(cuid())
  periodId String
  period   PcccPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  panelKey    String // "KICH_TU" | "DKTT"
  title       String // "THEO DÕI THÔNG SỐ HỆ THỐNG FM200 - PHÒNG KÍCH TỪ"
  binhLabels  String[] // ["1","2","3","4"] hoặc ["1A",…,"8B"] — giữ đúng thứ tự cột
  cuongVi     String? // nhãn chuẩn hoá, xem ghi chú ở PcccExtinguisher.cuongVi
  cuongViCode String?
  machine     String   @default("COMMON") // S1 | S2 | COMMON

  mucMin    Float?
  mucMax    Float?
  mucDvt    String? // "FT(Feet)"
  mucValues Json // { "<nhãn bình>": số|null }
  mucGhiChu String?

  apMin    Float?
  apMax    Float?
  apDvt    String?
  apValues Json
  apGhiChu String?

  ngayKiemTra  DateTime?
  nguoiKiemTra String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([periodId, panelKey])
  @@map("pccc_fm200_panels")
}

// Chữ ký xác nhận. Quy tắc gốc: SỬA BẤT KỲ TRƯỜNG NÀO của dòng/bảng thì chữ ký
// của dòng/bảng đó bị XOÁ, buộc ký lại. Vì vậy mỗi mục tiêu chỉ có TỐI ĐA 1 chữ
// ký đang hiệu lực; lịch sử ký/xoá ký nằm ở AuditLog, không nhân bản ở đây.
// TỦ ĐIỀU KHIỂN CHỮA CHÁY FM200/CO2 — mỗi bản ghi là một tủ ngoài hiện trường.
// Không dùng chung PcccFm200Panel: model kia là bảng thông số nhiều bình nằm ngang.
model PcccFireControlCabinet {
  id       String     @id @default(cuid())
  periodId String
  period   PcccPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  stt          Float?
  heThong      String
  ma           String
  viTri        String?
  cuongVi      String?
  cuongViCode  String?
  machine      String    @default("COMMON")
  tinhTrang    String?
  ghiChu       String?
  ngayKiemTra  DateTime?
  nguoiKiemTra String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([periodId, ma])
  @@index([periodId, cuongViCode])
  @@index([periodId, machine])
  @@index([periodId, tinhTrang])
  @@index([periodId, heThong])
  @@map("pccc_fire_control_cabinets")
}

model PcccSignature {
  id       String     @id @default(cuid())
  periodId String
  period   PcccPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  // Mục tiêu ký: "EXTINGUISHER" | "CABINET" | "BULK" | "FM200_PANEL"
  //             | "ALARM_BUTTON" | "VALVE" | "EMERGENCY_LIGHT" | "HOSE_REEL"
  targetType String
  targetId   String // id bản ghi tương ứng (không FK: 1 cột trỏ nhiều bảng)

  userId         String // id User đã ký
  signerName     String // chốt cứng tên lúc ký (đổi tên user sau này không làm sai lịch sử)
  signerPosition String? // cương vị lúc ký
  // Ảnh chữ ký số dùng lúc ký — chốt cứng S3 key CÙNG LÝ DO với signerName: user đổi
  // hoặc xoá chữ ký trong hồ sơ cá nhân thì bản ký cũ vẫn phải hiện đúng cái đã ký.
  signatureKey   String?  @map("signature_key")
  signedAt       DateTime @default(now())

  @@unique([targetType, targetId])
  @@index([periodId, targetType])
  @@index([userId])
  @@map("pccc_signatures")
}

// ============================================================================
// BỐN NHÓM THIẾT BỊ BỔ SUNG (đợt 2) — nút nhấn báo cháy, van chữa cháy, đèn
// EXIT / đèn chiếu sáng sự cố, cuộn vòi chữa cháy.
//
// Chia làm hai KIỂU, mỗi kiểu dùng lại đúng khuôn đã có ở trên:
//   - Kiểu "ô tích nhiều mức" (như PcccCabinet): PcccAlarmButton, PcccHoseReel.
//   - Kiểu "một ô tình trạng chọn đơn" (như PcccExtinguisher): PcccValve,
//     PcccEmergencyLight.
//
// KHOÁ NGHIỆP VỤ `rowKey`: khác BCC/TCC, các nguồn Excel mới KHÔNG có mã duy
// nhất — đo trên dữ liệu thật T07+T08.2026: NNBC có 6 cặp dòng trùng hệt nhau
// (cùng mã KKS, cùng vị trí, cùng cả STT), đèn EXIT có mã KKS lặp ở nhiều khu
// vực. Vì vậy mỗi dòng mang một khoá ổn định sinh lúc nhập liệu (mã + số thứ tự
// lần xuất hiện), để nhập lại nhiều lần không nhân bản và để chuyển kỳ ghép được
// dòng tháng trước với tháng sau.
// ============================================================================

// NÚT NHẤN BÁO CHÁY (NNBC) — 6 cột định danh + 3 nhóm ô tích (TEST NÚT NHẤN 3
// mức, CHUÔNG 2 mức, ĐÈN 2 mức) + 3 cột cuối. Nguồn Excel KHÔNG có cột "Số YCSC".
model PcccAlarmButton {
  id       String     @id @default(cuid())
  periodId String
  period   PcccPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  rowKey String // khoá nghiệp vụ ổn định — xem ghi chú đầu khối
  stt    Float?

  maKks     String
  tenKhuVuc String? // "Tên khu vực Layout"
  viTri     String? // "Vị trí cụ thể"

  cuongVi     String? // nhãn chuẩn hoá, xem ghi chú ở PcccExtinguisher.cuongVi
  cuongViCode String?
  machine     String  @default("COMMON") // S1 | S2 | COMMON

  nguoiGiamSat     String?
  nguoiGiamSatCode String?

  // Cột "Ghi chú khác" của sheet gốc: nhật ký kiểm tra nhiều đợt, giữ NGUYÊN VĂN
  // (có số PCT, ngày kiểm tra các đợt trước) — không tách, không cắt.
  khac         String?
  ngayKiemTra  DateTime?
  nguoiKiemTra String?

  // DẪN XUẤT từ các ô tích, cùng quy tắc với PcccCabinet.tinhTrangTongThe.
  tinhTrangTongThe String?

  deviceSeq String? // xem ghi chú ở PcccExtinguisher.deviceSeq

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  components PcccAlarmButtonComponent[]

  @@unique([periodId, rowKey])
  @@index([periodId, cuongViCode])
  @@index([periodId, machine])
  @@index([periodId, tinhTrangTongThe])
  @@index([periodId, maKks])
  @@index([deviceSeq])
  @@map("pccc_alarm_buttons")
}

// Một ô tích của bảng NNBC — cùng hình dạng và cùng quy tắc với
// PcccCabinetComponent (cho phép nhiều mức cùng tích trong một nhóm).
model PcccAlarmButtonComponent {
  id       String          @id @default(cuid())
  buttonId String
  button   PcccAlarmButton @relation(fields: [buttonId], references: [id], onDelete: Cascade)

  groupLabel  String // "TEST NÚT NHẤN" | "CHUÔNG" | "ĐÈN"
  status      String // "Bình thường" | "Có tác động" | "Không tác động" | …
  checked     Boolean @default(false)
  groupOrder  Int
  statusOrder Int

  @@unique([buttonId, groupLabel, status])
  @@index([buttonId])
  @@map("pccc_alarm_button_components")
}

// VAN CHỮA CHÁY — gồm cả van Deluge lẫn van Alarm, phân biệt qua `loaiVan`.
// `tinhTrang` có BỘ GIÁ TRỊ RIÊNG 3 mức (xem VALVE_TINH_TRANG_OPTIONS trong
// lib/pccc-status.ts): không dùng chung vốn từ của BCC hay TCC.
model PcccValve {
  id       String     @id @default(cuid())
  periodId String
  period   PcccPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  rowKey  String
  stt     Float?
  tenVan  String
  loaiVan String // "DELUGE" | "ALARM"
  maKks   String

  cuongVi     String?
  cuongViCode String?
  machine     String  @default("COMMON")

  nguoiGiamSat     String?
  nguoiGiamSatCode String?

  viTri     String?
  tinhTrang String? // "Khả dụng" | "Có suy giảm chức năng…" | "Không khả dụng"
  moTa      String?
  soYcsc    String?

  ngayKiemTra  DateTime?
  nguoiKiemTra String?

  deviceSeq String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([periodId, rowKey])
  @@index([periodId, cuongViCode])
  @@index([periodId, machine])
  @@index([periodId, tinhTrang])
  @@index([periodId, loaiVan])
  @@index([deviceSeq])
  @@map("pccc_valves")
}

// ĐÈN EXIT + ĐÈN CHIẾU SÁNG SỰ CỐ — MỘT bảng, phân biệt qua `loai`: hai sheet
// nguồn có hình dạng dữ liệu giống hệt nhau, tách bảng chỉ nhân đôi code.
//
// `tenKhuVuc`/`maBanVe`/`soLuongKhuVuc` là dữ liệu ở CẤP KHU VỰC (nhiều đèn dùng
// chung một bản vẽ Layout, trong Excel là ô merge) — đã được "trải" xuống từng
// dòng đèn lúc nhập liệu, đúng cách bản demo làm.
//
// `ketQuaTest` giữ NGUYÊN VĂN ô "Tháng MM/YYYY" mới nhất của sheet nguồn (chứa
// cả số phiếu YCSC); `tinhTrang` là bậc suy ra từ văn bản đó, có mức thứ ba
// "Không có đèn" — nghĩa là vị trí thực tế không lắp đèn, KHÔNG phải lỗi thiết
// bị, nên tô xám trung tính và không đếm vào tỉ lệ hỏng.
model PcccEmergencyLight {
  id       String     @id @default(cuid())
  periodId String
  period   PcccPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  loai   String // "EXIT" | "CSSC"
  rowKey String
  stt    Float?

  maKks         String
  tenKhuVuc     String?
  maBanVe       String?
  soLuongKhuVuc Float?

  cuongVi     String?
  cuongViCode String?
  machine     String  @default("COMMON")

  nguoiGiamSat     String?
  nguoiGiamSatCode String?

  tinhTrang  String? // "Đạt" | "Không đạt" | "Không có đèn"
  ketQuaTest String? // nguyên văn ô tháng gần nhất
  ghiChu     String?

  ngayKiemTra  DateTime?
  nguoiKiemTra String?

  deviceSeq String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([periodId, loai, rowKey])
  @@index([periodId, loai, cuongViCode])
  @@index([periodId, loai, machine])
  @@index([periodId, loai, tinhTrang])
  @@index([periodId, maKks])
  @@index([deviceSeq])
  @@map("pccc_emergency_lights")
}

// CUỘN VÒI CHỮA CHÁY (CVCC) — danh mục CON của tủ chữa cháy.
//
// KHÔNG có trong Excel gốc: bản demo tự sinh từ TCC lúc chạy (tủ INDOOR → 1
// cuộn, OUTDOOR → 2 cuộn). Ở đây LƯU THẬT vào DB, vì người dùng còn thêm/xoá tay
// và còn phải ký từng dòng — thứ bản demo không giữ được qua các lần tải trang.
// Sinh lần đầu bằng scripts/import-pccc-web-demo.ts; từ đó trở đi là dữ liệu thật.
//
// `cabinetId` thay cho cặp chuỗi `tuMa`/`tuTen` của bản demo: đổi mã tủ cha không
// làm mồ côi cuộn vòi. Xoá tủ thì cuộn vòi của nó đi theo.
model PcccHoseReel {
  id       String     @id @default(cuid())
  periodId String
  period   PcccPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  cabinetId String
  cabinet   PcccCabinet @relation(fields: [cabinetId], references: [id], onDelete: Cascade)

  stt   Float?
  ma    String // mã tự sinh từ mã tủ cha: đoạn "TCC" đổi thành "CVCC"
  ten   String? // "Cuộn vòi chữa cháy" | "Cuộn vòi chữa cháy #1" | "#2"
  viTri String?

  cuongVi     String?
  cuongViCode String?
  machine     String  @default("COMMON")

  soYcsc       String?
  ngayKiemTra  DateTime?
  nguoiKiemTra String?
  ghiChu       String?

  // DẪN XUẤT: chỉ 2 mức "Đạt"/"Không đạt" theo TB 5100/TB-NĐDH ngày 14/8/2026 —
  // KHÁC tủ chữa cháy (vẫn 3 mức vì văn bản không đề cập tới tủ). Xem
  // deriveHoseReelStatus() trong lib/pccc-status.ts.
  tinhTrangTongThe String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  components PcccHoseReelComponent[]

  @@unique([periodId, ma])
  @@index([periodId, cuongViCode])
  @@index([periodId, machine])
  @@index([cabinetId])
  @@map("pccc_hose_reels")
}

// Một ô tích của bảng CVCC — 2 nhóm "CUỘN ỐNG" (4 mức) và "LĂNG PHUN" (3 mức).
// Key lưu vẫn là vốn từ gốc của tủ chữa cháy ("Khả dụng"/"Bất khả dụng"…) vì dữ
// liệu được sao từ tủ cha; chỉ NHÃN HIỂN THỊ đổi thành "Đạt"/"Không đạt".
model PcccHoseReelComponent {
  id     String       @id @default(cuid())
  reelId String
  reel   PcccHoseReel @relation(fields: [reelId], references: [id], onDelete: Cascade)

  groupLabel  String // "CUỘN ỐNG" | "LĂNG PHUN"
  status      String
  checked     Boolean @default(false)
  groupOrder  Int
  statusOrder Int

  @@unique([reelId, groupLabel, status])
  @@index([reelId])
  @@map("pccc_hose_reel_components")
}

// ============================================================================
// TỒN KHO HÓA CHẤT — sổ theo dõi hóa chất & nhiên liệu của Phân xưởng Vận hành 1
//
// KHÔNG dùng chung Material/MaterialStockLot: các model đó lưu Int và phục vụ
// FIFO theo phiếu vật tư kho DH1, còn hóa chất là số thập phân do nhà thầu giao
// thẳng theo hợp đồng (xem commit 83aa5b5 — luồng hóa chất không cộng tồn kho,
// không trừ ERP).
//
// Đây là nhóm model ĐẦU TIÊN của repo dùng Decimal. Mọi giá trị Decimal PHẢI đi
// qua toNumber() trong lib/chemical-inventory/serialize.ts trước khi trả ra API —
// trả thẳng object Decimal sang Client Component thì Next 14 ném
// "Only plain objects can be passed to Client Components".
// Đặc tả đầy đủ: docs/ton-kho-hoa-chat-spec.md
// ============================================================================

/// Danh mục mặt hàng theo dõi: 6 hóa chất + 5 bồn HFO + 5 dòng dầu Diesel/DO.
/// Ứng đúng dòng 6..21 của các tab báo cáo tháng trong workbook nguồn.
model ChemicalInventoryItem {
  id            String  @id @default(cuid())
  code          String  @unique // NH3_99, NACLO_10, HFO_1, DIESEL_KHAN_1…
  name          String // đúng nhãn cột B của sheet, dùng để khớp khi import
  concentration String?
  itemType      String // CHEMICAL | HFO | DIESEL | OTHER
  baseUnit      String // KG | TON | LITER — đơn vị LƯU TRỮ, mọi phép cộng dùng đơn vị này
  displayUnit   String? // đơn vị HIỂN THỊ nếu khác baseUnit (NH3 lưu KG, nhật ký hiện TON)

  // MONTHLY: đọc tồn 1 lần/tháng trên lưới. DAILY: có nhật ký ngày (hiện chỉ NH3).
  // Mặt hàng DAILY thì dòng MONTH_END do server sinh, người dùng KHÔNG nhập tay.
  trackingMode String @default("MONTHLY")

  sheetRow     Int? // 6..21 — dòng cố định trong tab báo cáo tháng
  receiptSheet String? // tên tab phiếu nhập tương ứng; null với nhiên liệu (không có phiếu)
  materialCode String? // mã vật tư ERP, lấy từ tab Hợp đồng — dùng chung cho mọi năm

  /// Cương vị NHẬN hàng mặc định của mặt hàng này — điền sẵn khi tạo phiếu nhập.
  /// Suy từ dữ liệu thật: NH3 luôn về NH3-LHP, NaClO/PAC về XLN hỗn hợp, HCl/NaOH/NH4OH
  /// về Máy phó. Khác với cương vị GIỮ TỒN trên lưới tháng — HCl giữ ở ba nơi nhưng
  /// luôn do Máy phó nhận rồi mới phân về.
  defaultPosition String?

  tankCapacity      Decimal? @db.Decimal(18, 4) // sức chứa bồn, vẽ thanh mức
  lowStockThreshold Decimal? @db.Decimal(18, 4) // ngưỡng cảnh báo tồn thấp

  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  readings  ChemicalStockReading[]
  receipts  ChemicalReceipt[]
  contracts ChemicalContract[]

  @@index([itemType, sortOrder])
}

/// Kỳ nhập liệu theo tháng. Sổ giấy gộp nhiều năm vào một bảng dài; ở đây mỗi
/// tháng là một kỳ riêng, phải mở kỳ trước khi nhập.
model ChemicalInventoryPeriod {
  id        String @id @default(cuid())
  periodKey String @unique // "YYYY-MM"

  // DRAFT | LOCKED. CHƯA áp ràng buộc "n-1 phải khóa trước" — người dùng muốn chạy
  // thực tế xem sao. Giữ cột sẵn để bật quy tắc sau mà không phải migrate.
  status String @default("DRAFT")

  // Kỳ mồi (2025-12): chỉ mang tồn cuối để làm tồn đầu cho tháng 01/2026.
  // Không hiển thị trên giao diện, không tính tiêu hao.
  isSeed Boolean @default(false)

  generationMwh Decimal? @db.Decimal(18, 3) // sản lượng điện S1+S2, tính suất hao đầu cực kg/MWh

  lockedAt   DateTime?
  lockedById String?
  note       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  readings ChemicalStockReading[]

  @@index([status])
}

/// Một lần đọc tồn tại một cương vị. Khái niệm DUY NHẤT phục vụ cả lưới tháng
/// lẫn nhật ký ngày — không tách thành hai bảng để khỏi phải đồng bộ.
///
///   kind = "MONTH_END" → ô trên lưới tồn kho tháng
///   kind = "DAILY"     → một dòng nhật ký ngày (hiện chỉ NH3)
///
/// Với mặt hàng DAILY, dòng MONTH_END được SINH RA từ dòng DAILY của ngày cuối
/// cùng theo lịch của tháng (source = "DERIVED"). Ngày cuối tháng chưa có bản đọc
/// thì MONTH_END để null — TUYỆT ĐỐI không lấy bản đọc giữa tháng làm tồn cuối.
model ChemicalStockReading {
  id           String   @id @default(cuid())
  periodId     String
  periodKey    String // denormalize để truy vấn lưới tháng bằng một câu, tránh join thừa
  itemId       String
  positionCode String // PositionCode của lib/position-catalog.ts; "UNASSIGNED" nếu sheet không ghi
  readDate     DateTime @db.Date // ngày đọc (hiểu là mốc 24h00 của ngày đó)
  kind         String // DAILY | MONTH_END

  // null = CHƯA ĐỌC, khác hẳn 0 = đã đọc và bằng 0. Sheet phân biệt hai thứ này;
  // gộp lại là hỏng số liệu tiêu hao.
  quantity Decimal? @db.Decimal(18, 4)

  // Nguyên văn khi ô nguồn là chữ chứ không phải số — ví dụ "Mức bồn dầu DO lò hơi
  // phụ" tháng 07/2026 ghi mức mm đo tại DCS/Local chứ không phải thể tích.
  rawText String?

  note        String?
  source      String   @default("MANUAL") // MANUAL | SHEET_IMPORT | DERIVED
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  period ChemicalInventoryPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  item   ChemicalInventoryItem   @relation(fields: [itemId], references: [id])

  @@unique([itemId, positionCode, readDate, kind])
  @@index([periodKey, kind, itemId])
  @@index([itemId, readDate])
  @@index([periodId])
}

/// Một chuyến xe hóa chất về nhà máy.
///
/// CÓ HAI CỬA GHI: bước xác nhận lãnh của phiếu vật tư, và nhật ký ngày. Cùng một
/// chuyến xe. Khóa (itemId, receivedAt, vehicleNumber) là thứ chặn cộng đôi —
/// đã kiểm dữ liệu thật: trong cùng một ngày các biển số luôn khác nhau.
/// Cửa vào sau phải GẮN vào dòng đã có, không tạo dòng mới.
model ChemicalReceipt {
  id         String   @id @default(cuid())
  itemId     String
  receivedAt DateTime @db.Date

  // Suy từ receivedAt theo giờ Việt Nam. SERVER tự tính — client gửi lên thì bỏ qua.
  periodKey String

  // Biển số xe nhập hàng, đã chuẩn hóa: bỏ gạch/chấm/khoảng trắng, viết hoa, tối đa
  // 8 ký tự ("51C-214.77" → "51C21477"). Là khóa chống trùng cùng với (itemId, receivedAt).
  vehicleNumber String?

  // Nguyên văn ô "Xe" trong sổ Excel. Cũng là biển số nhưng thường GHI TẮT (chỉ vài
  // chữ số cuối, như 478, 269, 504). Giữ lại để đối chiếu với bản gốc.
  //
  // Lưu ý khi nối hai nguồn: sổ ghi tắt còn nhật ký ghi đủ, nên KHÔNG dò trùng theo
  // biển số — đối chiếu tháng 07/2026 cho thấy hai bên ghi khác hẳn nhau cho cùng
  // một chuyến. Khóa nối hai nguồn là (ngày + khối lượng), cặp đó khớp 17/17.
  vehicleRef String?

  plantWeight      Decimal? @db.Decimal(18, 4)
  contractorWeight Decimal? @db.Decimal(18, 4)

  // Luôn quy về baseUnit của mặt hàng. Bằng MIN(hai số cân) khi có đủ hai số.
  // Đây là con số DUY NHẤT dùng để tính tồn/tiêu hao/hợp đồng — không bao giờ so
  // với khối lượng đề xuất trên phiếu (lượng đề xuất chỉ là số tham khảo).
  acceptedWeight Decimal @db.Decimal(18, 4)

  receivingPosition    String? // PositionCode đã chuẩn hóa
  receivingPositionRaw String? // nguyên văn khi không chuẩn hóa được, vd nhiều cương vị trong một ô

  note   String?
  source String  @default("MANUAL") // MANUAL | SHEET_IMPORT | MATERIAL_TICKET | DAILY_LOG

  sourceSheet String?
  sourceRow   Int?
  sourceKey   String? @unique // "<fileHash>|<sheet>|<row>" — giữ import idempotent

  materialTicketId String? // phiếu vật tư đã gắn; có giá trị thì xóa phải hủy phiếu gốc

  warnings    String[] @default([])
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  item ChemicalInventoryItem @relation(fields: [itemId], references: [id])

  @@unique([itemId, receivedAt, vehicleNumber])
  @@index([periodKey, itemId])
  @@index([itemId, receivedAt])
  @@index([materialTicketId])
}

/// Hợp đồng cung cấp hóa chất theo năm.
/// KHÔNG lưu "đã nhận" — cột đó trong sheet gốc bị trộn lẫn lượng sử dụng từ tháng 9
/// (xem docs/ton-kho-hoa-chat-spec.md mục 3.7). Backend luôn cộng lại từ ChemicalReceipt.
model ChemicalContract {
  id     String @id @default(cuid())
  year   Int
  itemId String

  materialCode     String?
  supplier         String?
  origin           String?
  contractQuantity Decimal @db.Decimal(18, 4)
  forecastDemand   Decimal @default(0) @db.Decimal(18, 4)

  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  item ChemicalInventoryItem @relation(fields: [itemId], references: [id])

  @@unique([year, itemId])
  @@index([year])
}

/// Kết quả một lần import workbook (dry-run hoặc commit).
model ChemicalImportBatch {
  id       String @id @default(cuid())
  fileName String
  fileHash String
  status   String // PREVIEW | COMMITTED | FAILED

  importedRows Int @default(0)
  updatedRows  Int @default(0)
  skippedRows  Int @default(0)
  errorRows    Int @default(0)

  detail Json // { bySheet, issues, reconcile, summary }

  createdById String
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
