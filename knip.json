{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "next": true,
  "entry": [
    "app/**/{page,layout,route,loading,error,not-found,template,default}.{ts,tsx}",
    "middleware.ts",
    "prisma/seed.ts",
    "scripts/**/*.{ts,mjs}",
    "components/ui/**"
  ],
  "project": ["app/**/*.{ts,tsx}", "components/**/*.{ts,tsx}", "hooks/**/*.ts", "lib/**/*.ts", "types/**/*.ts"],
  "ignoreDependencies": ["playwright-core"],
  "ignoreBinaries": ["pm2"]
}
